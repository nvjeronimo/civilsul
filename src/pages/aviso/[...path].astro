---
// Variante "Aviso de Obra": todas as páginas (PT e EN) a partir de uma só rota.
import { variantPaths, type RouteProps } from '../../lib/routes';
import Home from '../../variants/aviso/pages/Home.astro';
import Services from '../../variants/aviso/pages/Services.astro';
import Service from '../../variants/aviso/pages/Service.astro';
import Works from '../../variants/aviso/pages/Works.astro';
import Work from '../../variants/aviso/pages/Work.astro';
import Quote from '../../variants/aviso/pages/Quote.astro';
import Contact from '../../variants/aviso/pages/Contact.astro';
import About from '../../variants/aviso/pages/About.astro';
import Privacy from '../../variants/aviso/pages/Privacy.astro';

export function getStaticPaths() {
  return variantPaths();
}
const { lang, page, id } = Astro.props as RouteProps;
---
{page === 'home' && <Home lang={lang} />}
{page === 'services' && !id && <Services lang={lang} />}
{page === 'services' && id && <Service lang={lang} id={id} />}
{page === 'works' && !id && <Works lang={lang} />}
{page === 'works' && id && <Work lang={lang} id={id} />}
{page === 'quote' && <Quote lang={lang} />}
{page === 'contact' && <Contact lang={lang} />}
{page === 'about' && <About lang={lang} />}
{page === 'privacy' && <Privacy lang={lang} />}

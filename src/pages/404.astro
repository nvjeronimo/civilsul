---
// Página não encontrada (GitHub Pages serve /404.html para qualquer endereço inexistente).
import Logo from '../components/Logo.astro';
import { BASE, VARIANTS } from '../lib/site';
import '@fontsource-variable/sofia-sans';
import '@fontsource-variable/sofia-sans-condensed';
---
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Página não encontrada · Civilsul</title>
  <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <main>
    <Logo size="3rem" tone="reverse" />
    <h1>Esta página não existe.</h1>
    <p>O endereço pode ter mudado. Escolha uma das versões da proposta:</p>
    <ul>
      <li><a href={BASE}>Proposta de redesign</a></li>
      {VARIANTS.map((v) => <li><a href={`${BASE}${v.id}/`}>{v.name}</a></li>)}
    </ul>
  </main>
</body>
</html>
<style is:global>
  body { margin: 0; min-height: 100svh; display: grid; place-items: center; background: #121417; color: #eef0ef; font: 400 1.125rem/1.6 'Sofia Sans Variable', system-ui, sans-serif; }
  main { width: min(100% - 32px, 560px); }
  h1 { font: 800 clamp(2.4rem, 7vw, 4rem)/1 'Sofia Sans Condensed Variable', sans-serif; margin: 2rem 0 1rem; }
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 1px solid #3a3f45; }
  li { border-bottom: 1px solid #3a3f45; }
  a { display: block; padding: 0.8rem 0; color: #fff; font-weight: 700; text-decoration: none; }
  a:hover, a:focus-visible { color: #ffe11a; }
  :focus-visible { outline: 3px solid #0b84cf; outline-offset: 3px; }
</style>

---
// Candidata B1 "Cal e Barra": só página inicial, só PT.
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/sofia-sans/wght.css';
import '../../variants/cal-e-barra/styles.css';
import { getImage } from 'astro:assets';
import Head from '../../components/Head.astro';
import Home from '../../variants/cal-e-barra/Home.astro';
import { meta } from '../../lib/meta';
import { workById } from '../../content/works';

const m = meta({ lang: 'pt', page: 'home' });
const og = await getImage({ src: workById('reconstrucao-ampliacao-moradia').photos[0].src, width: 1200, format: 'jpg' });
---
<html lang="pt-PT" class="cb">
  <head>
    <Head title={m.title} description={m.description} lang="pt" variant="cal-e-barra" page="home" image={og.src} themeColor="#F5F6F4" langs={['pt']} />
  </head>
  <body>
    <Home />
    <script>
      import '../../variants/cal-e-barra/barra.ts';
    </script>
  </body>
</html>

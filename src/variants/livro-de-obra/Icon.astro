---
// Ícones desenhados à mão para esta variante: grelha de 24, traço de 1.75, pontas redondas.
interface Props { name: 'phone' | 'chat' | 'mail' | 'pin' | 'arrow' }
const { name } = Astro.props;
---
<svg class="ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  {name === 'phone' && <path d="M6.7 3.75h2.4l1.35 3.9-1.9 1.3a11.6 11.6 0 0 0 6.5 6.5l1.3-1.9 3.9 1.35v2.4a1.9 1.9 0 0 1-2 1.95A15.9 15.9 0 0 1 4.75 5.75a1.9 1.9 0 0 1 1.95-2z" />}
  {name === 'chat' && <><path d="M4.2 19.8l1.2-3.7A7.9 7.9 0 1 1 8.3 18.7z" /><path d="M9 10.2h6M9 13.4h3.6" /></>}
  {name === 'mail' && <><rect x="3.25" y="5.25" width="17.5" height="13.5" rx="1.2" /><path d="M3.8 6.2l8.2 6.6 8.2-6.6" /></>}
  {name === 'pin' && <><path d="M12 20.8s-6.3-6-6.3-10.9a6.3 6.3 0 0 1 12.6 0c0 4.9-6.3 10.9-6.3 10.9z" /><circle cx="12" cy="9.9" r="2.2" /></>}
  {name === 'arrow' && <path d="M5 12h13.5M13 6.5l5.5 5.5-5.5 5.5" />}
</svg>

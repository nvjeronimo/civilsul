---
// O carimbo da empresa, desenhado em vetor: anel duplo, "CIVILSUL" no arco de cima, "ALVARÁ Nº 4511 · DESDE 1985"
// no arco de baixo (a direito, lido da esquerda para a direita) e o símbolo Civilsul ao centro.
// Tinta azul única; a "textura" é só opacidade (anéis e letras com cargas de tinta diferentes). Sem filtros.
// O círculo amarelo do logótipo só aparece aqui.
interface Props { class?: string }
const { class: cls } = Astro.props;
const uid = 'st' + Math.random().toString(36).slice(2, 7);
---
<div class:list={['stamp', cls]} data-stamp>
  <svg viewBox="0 0 200 200" role="img" aria-label="Carimbo da Civilsul: alvará nº 4511, desde 1985">
    <defs>
      <!-- arco de cima: da esquerda para a direita por cima (letras para fora) -->
      <path id={`${uid}-top`} d="M34 100 A66 66 0 0 1 166 100" />
      <!-- arco de baixo: da esquerda para a direita por baixo (letras para dentro, a direito) -->
      <path id={`${uid}-bot`} d="M22.5 100 A77.5 77.5 0 0 0 177.5 100" />
      <mask id={`${uid}-m`} maskUnits="userSpaceOnUse" x="0" y="0" width="480" height="480">
        <rect width="480" height="480" fill="#fff" />
        <polygon points="240,126 354,240 240,354 126,240" fill="#000" />
      </mask>
    </defs>
    <g fill="none" stroke="currentColor">
      <circle cx="100" cy="100" r="96" stroke-width="3.6" stroke-opacity="0.95" />
      <circle cx="100" cy="100" r="90.5" stroke-width="1" stroke-opacity="0.8" />
      <circle cx="100" cy="100" r="55" stroke-width="1.4" stroke-opacity="0.88" />
    </g>
    <g fill="currentColor" class="stamp__legend">
      <text font-size="19" font-weight="800" letter-spacing="5.2" fill-opacity="0.94" text-anchor="middle">
        <textPath href={`#${uid}-top`} startOffset="50%">CIVILSUL</textPath>
      </text>
      <text font-size="10.2" font-weight="700" letter-spacing="0.45" fill-opacity="0.86" text-anchor="middle">
        <textPath href={`#${uid}-bot`} startOffset="50%">ALVARÁ Nº 4511 · DESDE 1985</textPath>
      </text>
      <circle cx="27.5" cy="100" r="2.6" fill-opacity="0.9" />
      <circle cx="172.5" cy="100" r="2.6" fill-opacity="0.9" />
    </g>
    <g transform="translate(100 100) scale(0.2) translate(-240 -240)">
      <g mask={`url(#${uid}-m)`}>
        <g transform="translate(170 240) rotate(45)"><rect x="-106" y="-106" width="212" height="212" rx="38" fill="currentColor" fill-opacity="0.94" /></g>
        <g transform="translate(310 240) rotate(45)"><rect x="-106" y="-106" width="212" height="212" rx="38" fill="currentColor" fill-opacity="0.52" /></g>
      </g>
      <circle cx="240" cy="240" r="70" fill="#FFE500" />
    </g>
  </svg>
</div>

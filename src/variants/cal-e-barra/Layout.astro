---
// Moldura comum: <head>, cabeçalho, rodapé e barra fixa móvel. Na página inicial o cabeçalho ocupa só 5/12.
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/sofia-sans/wght.css';
import './styles.css';
import Head from '../../components/Head.astro';
import Logo from '../../components/Logo.astro';
import Icon from './Icon.astro';
import { SITE, BASE, UI, CALL_NOTE, href, whatsapp, type PageKey } from '../../lib/site';
import type { RouteProps } from '../../lib/routes';
import { meta } from '../../lib/meta';
import { C } from './copy';

interface Props extends RouteProps { image?: string; jsonLd?: Record<string, unknown>[] }
const { lang, page, id, image, jsonLd } = Astro.props;
const V = 'cal-e-barra' as const;
const u = UI.pt;
const m = meta({ lang, page, id });
const home = page === 'home';
const nav: { key: PageKey; label: string }[] = [
  { key: 'services', label: u.nav.services },
  { key: 'works', label: u.nav.works },
  { key: 'about', label: u.nav.about },
  { key: 'contact', label: u.nav.contact },
];
const cur = (k: PageKey) => (page === k ? (id ? 'true' : 'page') : undefined);
const quote = href(V, lang, 'quote');
const year = new Date().getFullYear();
---
<html lang="pt-PT" class="cb">
  <head>
    <Head title={m.title} description={m.description} lang="pt" variant={V} page={page} id={id} image={image} jsonLd={jsonLd} themeColor="#F5F6F4" langs={['pt']} />
  </head>
  <body>
    <a class="skip" href="#main">{u.skip}</a>

    <header class:list={['hd', home && 'hd--split']}>
      <div class="hd__in">
        <div class="hd__top">
          <a class="hd__brand" href={href(V, lang, 'home')} aria-label={`Civilsul, ${C.home.toLowerCase()}`}>
            <Logo size="2rem" />
            <span class="hd__name">Civilsul</span>
          </a>
          <div class="hd__phone">
            <a class="num" href={`tel:${SITE.mobile.tel}`}>{SITE.mobile.display}</a>
            <small>{CALL_NOTE.mobile.pt}</small>
          </div>
          <button class="hd__menu" type="button" aria-expanded="false" aria-controls="menu" hidden data-menu-btn>
            <span data-open><Icon name="menu" />{C.menu}</span>
            <span data-close hidden><Icon name="close" />{C.close}</span>
          </button>
        </div>
        <nav class="hd__nav" id="menu" aria-label={C.mainNav} data-menu>
          <ul role="list">
            {nav.map((n) => <li><a href={href(V, lang, n.key)} aria-current={cur(n.key)}>{n.label}</a></li>)}
          </ul>
          <a class="btn btn--line btn--sm hd__cta" href={quote} aria-current={cur('quote')}>{u.nav.quote}</a>
          <div class="hd__mphone">
            <a class="num" href={`tel:${SITE.mobile.tel}`}>{SITE.mobile.display}</a>
            <small>{CALL_NOTE.mobile.pt}</small>
          </div>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="ft">
      <div class="wrap ft__grid">
        <div class="ft__id">
          <a class="ft__brand" href={href(V, lang, 'home')} aria-label={`Civilsul, ${C.home.toLowerCase()}`}><Logo size="1.75rem" /><span>Civilsul</span></a>
          <p><strong>{SITE.legalName}</strong><br />{u.permit} · {u.since}<br />{SITE.address.street}<br />{SITE.address.postal} {SITE.address.city}, {SITE.address.region}</p>
        </div>
        <dl class="ft__lines">
          <div><dt>{C.mobile}</dt><dd><a href={`tel:${SITE.mobile.tel}`}>{SITE.mobile.display}</a><small>{CALL_NOTE.mobile.pt}</small></dd></div>
          {SITE.landlines.map((l) => (
            <div><dt>{C.landline}</dt><dd><a href={`tel:${l.tel}`}>{l.display}</a><small>{CALL_NOTE.landline.pt}</small></dd></div>
          ))}
          <div><dt>{u.email}</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        </dl>
        <nav class="ft__nav" aria-label="Rodapé">
          <ul role="list">
            {nav.map((n) => <li><a href={href(V, lang, n.key)}>{n.label}</a></li>)}
            <li><a href={quote}>{u.nav.quote}</a></li>
            <li><a href={href(V, lang, 'privacy')} aria-current={cur('privacy')}>{u.privacy}</a></li>
          </ul>
        </nav>
        <p class="ft__demo">
          <a href={BASE}>{u.demo}</a>
          <span>© {year} Civilsul. {u.rights}</span>
        </p>
      </div>
    </footer>

    <nav class:list={['dock', page === 'quote' && 'dock--two']} aria-label={C.quick}>
      <a href={`tel:${SITE.mobile.tel}`} aria-label={`${u.call} ${SITE.mobile.display} (${CALL_NOTE.mobile.pt})`}><Icon name="phone" />{u.call}</a>
      <a href={whatsapp('pt')} target="_blank" rel="noopener"><Icon name="chat" />{u.whatsapp}</a>
      {page !== 'quote' && <a href={quote}><Icon name="arrow" />Orçamento</a>}
    </nav>

    <script>
      import './barra.ts';
      import './menu.ts';
    </script>
  </body>
</html>

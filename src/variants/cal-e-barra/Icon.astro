---
// Ícones desenhados para a variante (traço 1.75, pontas redondas, 24×24). Sem glifos unicode.
interface Props { name: 'phone' | 'chat' | 'mail' | 'pin' | 'arrow' | 'arrow-left' | 'menu' | 'close'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class:list={['ic', cls]} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="M5.2 3.5h3l1.7 4.3-2.2 1.4a11.5 11.5 0 0 0 7.1 7.1l1.4-2.2 4.3 1.7v3a1.6 1.6 0 0 1-1.7 1.6A17 17 0 0 1 3.6 5.2a1.6 1.6 0 0 1 1.6-1.7Z" />}
  {name === 'chat' && <path d="M20.5 11.6a8.3 8.3 0 0 1-12.2 7.3L3.5 20.5l1.6-4.6a8.3 8.3 0 1 1 15.4-4.3Z" />}
  {name === 'mail' && <><path d="M3.5 5.5h17v13h-17z" /><path d="m4 6.2 8 6.3 8-6.3" /></>}
  {name === 'pin' && <><path d="M12 21s6.8-6 6.8-11.2a6.8 6.8 0 1 0-13.6 0C5.2 15 12 21 12 21Z" /><circle cx="12" cy="9.8" r="2.4" /></>}
  {name === 'arrow' && <path d="M4.5 12h15M13.5 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19.5 12h-15M10.5 6l-6 6 6 6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
</svg>

---
import Wall from '../Wall.astro';
import PageHead from '../PageHead.astro';
import { UI, href } from '../../../lib/site';
import { PRIVACY } from '../../../content/privacy';
import { C } from '../copy';
const V = 'cal-e-barra' as const;
---
<Wall first label="t-page" size="s">
  <PageHead crumbs={[[C.home, href(V, 'pt', 'home')], [UI.pt.privacy]]} title={C.privacyH} lede={C.privacyLead} />
</Wall>
<Wall label="t-priv" size="xs" body="pv">
  <h2 id="t-priv" class="vh">{C.privacyH}</h2>
  {PRIVACY.pt.map((b) => (
    <section class="pv__b">
      <h3>{b.h}</h3>
      {b.p.map((p) => <p>{p}</p>)}
    </section>
  ))}
</Wall>

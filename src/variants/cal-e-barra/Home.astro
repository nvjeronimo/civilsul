---
// "Cal e Barra": a página inicial construída como uma casa algarvia.
// Parede de cal como fundo, barra pintada no pé de cada secção, platibanda no remate.
import { Picture } from 'astro:assets';
import Logo from '../../components/Logo.astro';
import Icon from './Icon.astro';
import Crown from './Crown.astro';
import { SITE, UI, CALL_NOTE, BASE, whatsapp } from '../../lib/site';
import { SERVICES, TRADES } from '../../content/services';
import { workById } from '../../content/works';
import { MISSION, WHO, TEAM, INVITE, PROCESS } from '../../content/company';

const u = UI.pt;
const wa = whatsapp('pt');
const mail = `mailto:${SITE.email}?subject=${encodeURIComponent('Pedido de orçamento')}&body=${encodeURIComponent('Tipo de obra:\nLocal:\nPara quando:\n')}`;
const home = `${BASE}cal-e-barra/`;
const year = new Date().getFullYear();

const hero = workById('reconstrucao-ampliacao-moradia');
const house = workById('vale-del-rey');

// Obras na parede: cada uma é uma janela. span = colunas ocupadas em 12, shape = proporção da abertura.
const wins: { id: string; photo?: number; cls: string; span: number }[] = [
  { id: 'vale-del-rey', cls: 'w1 land-wide', span: 8 },
  { id: 'fachada-portaldegenios', cls: 'w2 port', span: 4 },
  { id: 'maison-amarande', cls: 'w3 port', span: 4 },
  { id: 'monte-do-pocinho', cls: 'w4 land', span: 7 },
  { id: 'construcao-moradia', cls: 'w5 land', span: 6 },
  { id: 'remodelacao-moradia', cls: 'w6 port', span: 4 },
  { id: 'reconstrucao-edificio', cls: 'w7 port', span: 4 },
  { id: 'arranjos-exteriores-piscina', cls: 'w8 land-wide', span: 8 },
];
const winSizes = (span: number) => `(min-width: 900px) ${Math.round((span / 12) * 100)}vw, calc(100vw - 32px)`;

// Os itens do serviço lidos como uma frase: "Inclui a, b e c." (sem separadores pendurados no fim da linha)
const includes = (items: string[]) => {
  const l = items.map((t) => t.charAt(0).toLowerCase() + t.slice(1));
  return `${u.includes} ${l.length > 1 ? `${l.slice(0, -1).join(', ')} e ${l.at(-1)}` : l[0]}.`;
};

const nav = [
  { href: '#servicos', label: u.nav.services },
  { href: '#obras', label: u.nav.works },
  { href: '#empresa', label: u.nav.about },
  { href: '#contactos', label: u.nav.contact },
];
const facts = [SITE.legalName, u.permit, u.since, 'Sede em Quarteira, Algarve', u.area];
---
<a class="skip" href="#main">{u.skip}</a>

<header class="hd">
  <div class="hd__in">
    <div class="hd__top">
      <a class="hd__brand" href={home} aria-label="Civilsul, início">
        <Logo size="2rem" />
        <span class="hd__name">Civilsul</span>
      </a>
      <div class="hd__phone">
        <a class="num" href={`tel:${SITE.mobile.tel}`}>{SITE.mobile.display}</a>
        <small>{CALL_NOTE.mobile.pt}</small>
      </div>
    </div>
    <nav class="hd__nav" aria-label="Secções da página">
      <ul role="list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <a class="btn btn--line btn--sm hd__cta" href="#contactos">{u.nav.quote}</a>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1">
  <section class="hero" aria-labelledby="t-hero">
    <div class="hero__grid">
      <div class="hero__text">
        <h1 id="t-hero">Construímos, reconstruímos e remodelamos no Algarve desde 1985.</h1>
        <p class="hero__lede">Moradias de raiz, casas antigas refeitas e aumentadas, apartamentos, piscinas e exteriores. A mesma equipa, das fundações aos acabamentos.</p>
      </div>
      <figure class="hero__win win">
        <div class="win__glass">
          <Picture
            src={hero.photos[0].src}
            alt={hero.photos[0].alt.pt}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(min-width: 900px) 56vw, calc(100vw - 32px)"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption>{hero.title.pt}</figcaption>
      </figure>
    </div>
    <div class="barra barra--hero" data-barra>
      <div class="barra__in hero__barra">
        <div class="hero__actions">
          <a class="btn btn--cal" href="#contactos">{u.nav.quote}<Icon name="arrow" /></a>
          <a class="btn btn--line-cal" href={wa} target="_blank" rel="noopener"><Icon name="chat" />{u.whatsapp}</a>
        </div>
        <ul class="hero__facts" role="list">
          <li>{u.since}</li>
          <li>{u.permit}</li>
          <li>Quarteira, Algarve</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wall" id="servicos" aria-labelledby="t-servicos">
    <Crown />
    <div class="wrap wall__body svc">
      <div class="svc__head">
        <h2 id="t-servicos">Da moradia de raiz à reparação do telhado.</h2>
        <p>Construção, reconstrução, remodelação e manutenção. As especialidades ficam com a mesma empresa: eletricidade, canalização, carpintaria, revestimentos e pintura.</p>
      </div>
      <div class="svc__body">
        <ul class="svc__rows" role="list">
          {SERVICES.map((s) => (
            <li class="svc__row">
              <h3>{s.title.pt}</h3>
              <div>
                <p class="svc__short">{s.short.pt}</p>
                <p class="svc__items">{includes(s.items.map((i) => i.pt))}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="trades" id="trabalhos">
          <h3>Todos os trabalhos que executamos</h3>
          <ul role="list">
            {TRADES.map((t) => <li>{t.pt}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="barra barra--ocre barra--s" data-barra></div>
  </section>

  <section class="wall" id="obras" aria-labelledby="t-obras">
    <Crown />
    <div class="wrap wall__body">
      <div class="obras__head">
        <h2 id="t-obras">Obras entregues, de Vale del Rey ao Monte do Pocinho.</h2>
        <p>Moradias novas, casas antigas reconstruídas, fachadas preservadas, apartamentos remodelados e exteriores. As fotografias são das obras terminadas.</p>
      </div>
      <ul class="obras" role="list">
        {wins.map((w) => {
          const work = workById(w.id);
          const ph = work.photos[w.photo ?? 0];
          const meta = work.place ?? work.client;
          return (
            <li class:list={['win', w.cls]}>
              <figure>
                <div class="win__glass">
                  <Picture src={ph.src} alt={ph.alt.pt} formats={['avif', 'webp']} widths={[480, 720, 960, 1280, 1600]} sizes={winSizes(w.span)} loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <span class="win__t">{work.title.pt}</span>
                  {meta && <span class="win__m">{meta}</span>}
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
    </div>
    <div class="barra barra--m" data-barra></div>
  </section>

  <section class="wall" id="empresa" aria-labelledby="t-empresa">
    <Crown />
    <div class="wrap wall__body co">
      <div class="co__text">
        <h2 id="t-empresa">Uma construtora com alvará desde 1985.</h2>
        <p class="co__lead">{MISSION.pt}</p>
        <div class="co__cols">
          <p>{WHO.pt}</p>
          <p>{TEAM.pt}</p>
        </div>
      </div>
      <figure class="win co__win">
        <div class="win__glass">
          <Picture src={house.photos[1].src} alt={house.photos[1].alt.pt} formats={['avif', 'webp']} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 34vw, calc(100vw - 32px)" loading="lazy" decoding="async" />
        </div>
        <figcaption>{house.title.pt}</figcaption>
      </figure>
    </div>
    <div class="barra barra--facts" data-barra>
      <ul class="barra__in facts" role="list" aria-label="A empresa em factos">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="wall" id="processo" aria-labelledby="t-processo">
    <Crown />
    <div class="wrap wall__body pr">
      <h2 id="t-processo">Como começa uma obra connosco.</h2>
      <ol class="pr__steps" role="list">
        {PROCESS.map((p, i) => (
          <li>
            <span class="pr__n" aria-hidden="true">{i + 1}</span>
            <h3>{p.title.pt}</h3>
            <p>{p.text.pt}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="barra barra--ocre barra--xs" data-barra></div>
  </section>

  <section class="wall" id="contactos" aria-labelledby="t-contactos">
    <Crown />
    <div class="wrap wall__body ct">
      <div class="ct__lead">
        <h2 id="t-contactos">Peça orçamento para a sua obra.</h2>
        <p>{INVITE.pt}</p>
        <p class="ct__tip">{PROCESS[0].text.pt}</p>
        <div class="ct__actions">
          <a class="btn btn--anil" href={wa} target="_blank" rel="noopener"><Icon name="chat" />Pedir orçamento por WhatsApp</a>
          <a class="btn btn--line" href={mail}><Icon name="mail" />Pedir por email</a>
        </div>
      </div>
      <dl class="ct__lines">
        <div class="ct__line">
          <dt>Telemóvel</dt>
          <dd>
            <a class="num" href={`tel:${SITE.mobile.tel}`}>{SITE.mobile.display}</a>
            <small>{CALL_NOTE.mobile.pt}</small>
          </dd>
        </div>
        <div class="ct__line">
          <dt>Rede fixa</dt>
          {SITE.landlines.map((l) => (
            <dd>
              <a class="num" href={`tel:${l.tel}`}>{l.display}</a>
              <small>{CALL_NOTE.landline.pt}</small>
            </dd>
          ))}
        </div>
        <div class="ct__line">
          <dt>{u.email}</dt>
          <dd><a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        </div>
        <div class="ct__line">
          <dt>{u.address}</dt>
          <dd>
            <address>{SITE.address.street}<br />{SITE.address.postal} {SITE.address.city}, {SITE.address.region}</address>
            <a class="ct__map" href={SITE.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" />{u.directions}</a>
          </dd>
        </div>
      </dl>
    </div>
    <div class="barra barra--m" data-barra></div>
  </section>
</main>

<footer class="ft">
  <div class="wrap ft__row">
    <div class="ft__id">
      <a class="ft__brand" href={home} aria-label="Civilsul, início"><Logo size="1.75rem" /><span>Civilsul</span></a>
      <p><strong>{SITE.legalName}</strong><br />{u.permit} · {u.since}<br />{SITE.address.street}, {SITE.address.postal} {SITE.address.city}</p>
    </div>
    <nav class="ft__nav" aria-label="Rodapé">
      <ul role="list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="#trabalhos">Lista de trabalhos</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </nav>
    <p class="ft__demo">
      <a href={BASE}>{u.demo}</a>
      <span>© {year} Civilsul. {u.rights}</span>
    </p>
  </div>
</footer>

<nav class="dock" aria-label="Contacto rápido">
  <a href={`tel:${SITE.mobile.tel}`} aria-label={`${u.call} ${SITE.mobile.display} (${CALL_NOTE.mobile.pt})`}><Icon name="phone" />{u.call}</a>
  <a href={wa} target="_blank" rel="noopener"><Icon name="chat" />{u.whatsapp}</a>
  <a href="#contactos"><Icon name="arrow" />Orçamento</a>
</nav>

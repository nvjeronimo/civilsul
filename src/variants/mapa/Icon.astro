---
// Ícones desenhados para a variante: traço 1.75, pontas retas, grelha 24.
type Name = 'phone' | 'chat' | 'mail' | 'arrow' | 'arrow-left' | 'menu' | 'close' | 'pin' | 'out' | 'check';
interface Props { name: Name; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="M5 3.5h3.6l1.7 4.6-2.3 1.5a11.5 11.5 0 0 0 6.4 6.4l1.5-2.3 4.6 1.7V19a1.5 1.5 0 0 1-1.5 1.5A16.5 16.5 0 0 1 3.5 5 1.5 1.5 0 0 1 5 3.5Z" />}
  {name === 'chat' && <><path d="M4 20l1.3-4A8 8 0 1 1 8.2 19Z" /><path d="M9 10.5h6M9 13.5h4" /></>}
  {name === 'mail' && <><path d="M3.5 5.5h17v13h-17z" /><path d="m4 6 8 6.5L20 6" /></>}
  {name === 'arrow' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'arrow-left' && <path d="M20 12H5M10.5 6.5 5 12l5.5 5.5" />}
  {name === 'menu' && <path d="M3.5 7h17M3.5 12h17M3.5 17h17" />}
  {name === 'close' && <path d="m5.5 5.5 13 13M18.5 5.5l-13 13" />}
  {name === 'pin' && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><path d="M12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z" /></>}
  {name === 'out' && <><path d="M13.5 4.5h6v6M19.5 4.5l-9 9" /><path d="M18 14v5.5H4.5V6H10" /></>}
  {name === 'check' && <path d="m4.5 12.5 4.5 4.5 10.5-10.5" />}
</svg>

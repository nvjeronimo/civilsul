---
import Plate from '../Plate.astro';
import Icon from '../Icon.astro';
import Close from '../Close.astro';
import { UI, href, type Lang } from '../../../lib/site';
import { WORKS, KINDS, workById } from '../../../content/works';
import { serviceById } from '../../../content/services';
import { C } from '../copy';
import { TIPO } from '../tipo';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const u = UI[lang];
const w = workById(id);
const i = WORKS.findIndex((x) => x.id === id);
const prev = WORKS[(i - 1 + WORKS.length) % WORKS.length];
const next = WORKS[(i + 1) % WORKS.length];
const s = serviceById(w.service);
const kind = KINDS.find((k) => k.id === w.kind)!.label[lang];
---
<div class="wrap">
  <header class="wh">
    <ol class="crumbs"><li><a href={href('mapa', lang, 'home')}>{C.home[lang]}</a></li><li><a href={href('mapa', lang, 'works')}>{u.nav.works}</a></li><li aria-current="page">{w.code}</li></ol>
    <div class="wh__grid">
      <div>
        <p class="wh__code" aria-hidden="true">{w.code}</p>
        <h1><span class="vh">{w.code}. </span>{w.title[lang]}</h1>
      </div>
      <dl class="facts wh__facts" data-draw>
        <div class="ru ru--ink"><dt>{C.kind[lang]}</dt><dd>{kind}</dd></div>
        {w.place && <div class="ru"><dt>{C.place[lang]}</dt><dd>{w.place}</dd></div>}
        {w.client && <div class="ru"><dt>{C.client[lang]}</dt><dd>{w.client}</dd></div>}
        <div class="ru"><dt>{C.service[lang]}</dt><dd><a class="pen" href={href('mapa', lang, 'services', s.slug[lang])}>{C.col.art[lang]} {s.code} · {s.title[lang]}</a></dd></div>
        <div class="ru ru--end"><dt>{C.photos[lang]}</dt><dd>{w.photos.length}</dd></div>
      </dl>
    </div>
  </header>

  <div class="photos">
    {w.photos.map((p, n) => {
      const portrait = p.src.height > p.src.width;
      return (
        <Plate class={portrait ? 'is-portrait' : 'is-land'} src={p.src} alt={p.alt[lang]} code={w.photos.length > 1 ? `${w.code}.${n + 1}` : w.code}
          title={p.alt[lang]} meta={w.place} sizes={portrait ? '(min-width: 900px) 62vh, 100vw' : '(min-width: 1560px) 1500px, 100vw'}
          widths={[640, 960, 1280, 1680, 2200]} eager={n === 0} ratio={`${p.src.width} / ${p.src.height}`} />
      );
    })}
  </div>

  <nav class="pn" aria-label={lang === 'pt' ? 'Outras obras' : 'Other projects'}>
    <a class="pn__a" href={href('mapa', lang, 'works', prev.slug[lang])} rel="prev">
      <span class="pn__dir"><Icon name="arrow-left" />{C.prev[lang]}</span>
      <span class="pn__t"><span class="num">{prev.code}</span> {prev.title[lang]}</span>
    </a>
    <a class="pn__a pn__a--next" href={href('mapa', lang, 'works', next.slug[lang])} rel="next">
      <span class="pn__dir">{C.next[lang]}<Icon name="arrow" /></span>
      <span class="pn__t"><span class="num">{next.code}</span> {next.title[lang]}</span>
    </a>
  </nav>
</div>
<Close lang={lang} title={C.workCta[lang]} tipo={TIPO[w.service]} />

<style is:global>
  .wh { padding-top: clamp(2rem, 1rem + 3vw, 4.5rem); padding-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .wh__grid { display: grid; gap: 2rem 4rem; align-items: end; }
  .wh__code { font-family: var(--f-disp); font-weight: 800; font-size: clamp(4.5rem, 3rem + 6vw, 9rem); line-height: 0.8; color: var(--pen); margin-bottom: 1.25rem; }
  .wh h1 { font-size: var(--t-h1); max-width: 18ch; }
  @media (min-width: 900px) { .wh__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }

  .photos { display: grid; gap: clamp(2.5rem, 2rem + 2vw, 4rem); justify-items: center; }
  .photos .plate { width: 100%; }
  .photos .is-portrait { width: min(100%, calc(84svh * 0.75)); }
  .photos .plate__title { font-weight: 400; color: var(--ink-2); }

  .pn { display: grid; grid-template-columns: 1fr; margin-top: var(--sec); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .pn__a { display: grid; gap: 0.5rem; padding: 1.5rem 0.5rem; text-decoration: none; min-height: 44px; }
  .pn__a + .pn__a { border-top: 1px solid var(--rule); }
  .pn__a:hover { background-image: var(--hatch); }
  .pn__dir { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--t-small); color: var(--ink-3); font-weight: 600; }
  .pn__dir svg { width: 1.2rem; height: 1.2rem; color: var(--pen-text); }
  .pn__t { font-family: var(--f-disp); font-weight: 720; font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.85rem); line-height: 1.1; }
  @media (min-width: 900px) {
    .pn { grid-template-columns: 1fr 1fr; }
    .pn__a + .pn__a { border-top: 0; border-left: 1px solid var(--rule); }
    .pn__a--next { text-align: right; justify-items: end; }
  }
</style>

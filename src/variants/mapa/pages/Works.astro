---
import Plate from '../Plate.astro';
import Close from '../Close.astro';
import { UI, href, type Lang } from '../../../lib/site';
import { WORKS, KINDS } from '../../../content/works';
import { C } from '../copy';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = UI[lang];
---
<div class="wrap">
  <header class="pagehead">
    <ol class="crumbs"><li><a href={href('mapa', lang, 'home')}>{C.home[lang]}</a></li><li aria-current="page">{u.nav.works}</li></ol>
    <h1>{C.worksH[lang]}</h1>
    <p class="lead">{C.worksLead[lang]}</p>
  </header>

  <div class="fbar ru ru--ink" data-filter hidden data-draw>
    <div class="fbar__btns" role="group" aria-label={C.filterLabel[lang]}>
      <button type="button" data-k="all" aria-pressed="true">{C.filterAll[lang]}</button>
      {KINDS.map((k) => <button type="button" data-k={k.id} aria-pressed="false">{k.label[lang]}</button>)}
    </div>
    <p class="fbar__n" aria-live="polite"><span class="num" data-count>{WORKS.length}</span> {C.showing[lang]}</p>
  </div>

  <ol class="grid">
    {WORKS.map((w) => (
      <li data-kind={w.kind} id={`a-${w.code.slice(2)}`}>
        <Plate src={w.photos[0].src} alt={w.photos[0].alt[lang]} code={w.code} title={w.title[lang]} meta={w.place}
          href={href('mapa', lang, 'works', w.slug[lang])} sizes="(min-width: 1100px) 31vw, (min-width: 640px) 46vw, 100vw" widths={[480, 720, 960]}
          ratio="1 / 1" headingLevel="h2" />
      </li>
    ))}
  </ol>
</div>
<Close lang={lang} />

<script>
  import '../filter.ts';
</script>

<style is:global>
  .fbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; padding: 0.9rem 0; margin-bottom: 2rem; border-bottom: 1px solid var(--rule); }
  .fbar__btns { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fbar button {
    min-height: 44px; padding: 0.5rem 1rem; border: 1px solid var(--rule-2); background: transparent; color: var(--ink);
    font: 620 1rem/1 var(--f-body); cursor: pointer;
  }
  .fbar button:hover { background-image: var(--hatch); border-color: var(--ink); }
  .fbar button[aria-pressed='true'] { border-color: var(--pen); background-image: var(--hatch-pen); box-shadow: inset 0 0 0 1px var(--pen); font-weight: 720; }
  .fbar__n { color: var(--ink-3); font-size: var(--t-small); }
  .fbar__n .num { font-size: 1.25rem; }
  .grid { display: grid; gap: 2.5rem 1.75rem; grid-template-columns: 1fr; }
  .grid .plate__title { font-family: var(--f-body); font-size: var(--t-small); font-weight: 600; letter-spacing: 0; line-height: 1.3; }
  @media (min-width: 640px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>

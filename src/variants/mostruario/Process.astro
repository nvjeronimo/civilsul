---
import { PROCESS } from '../../content/company';
---
<ol class="proc">
  {PROCESS.map((p, i) => (
    <li>
      <span class="proc__n tnum" aria-hidden="true">{i + 1}</span>
      <h3>{p.title.pt}</h3>
      <p>{p.text.pt}</p>
    </li>
  ))}
</ol>
<style>
  .proc { display: grid; gap: 0 1.5rem; counter-reset: p; }
  .proc li { display: grid; gap: 0.5rem; align-content: start; padding: 1.25rem 0 1.75rem; border-top: 1px solid var(--hair-2); }
  .proc__n { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--hair-2); border-radius: 50%; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; }
  .proc h3 { font-size: 1.3rem; }
  .proc p { color: var(--fg-2); max-width: 32ch; }
  @media (min-width: 760px) { .proc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .proc { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

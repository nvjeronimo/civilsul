---
// Bloco final: pedido de orçamento + contacto direto. Fundo carvão.
import Icon from './Icon.astro';
import { SITE, UI, CALL_NOTE, href, whatsapp } from '../../lib/site';
import { C } from './copy';
interface Props { title?: string; lead?: string; tipo?: string }
const { title = C.finalH, lead = C.finalLead, tipo } = Astro.props;
const u = UI.pt;
const q = href('mostruario', 'pt', 'quote') + (tipo ? `?tipo=${tipo}` : '');
---
<section class="fin board" aria-labelledby="fin-h">
  <div class="wrap fin__grid">
    <div>
      <h2 id="fin-h">{title}</h2>
      <p class="lead">{lead}</p>
      <div class="actions">
        <a class="btn btn--primary" href={q}><span class="dot" aria-hidden="true"></span>{u.nav.quote}</a>
        <a class="btn" href={whatsapp('pt')} rel="noopener" target="_blank"><Icon name="chat" />{C.heroWa}</a>
      </div>
    </div>
    <div class="fin__direct">
      <p class="fin__label">{C.orCall}</p>
      <div class="phone"><a class="tel" href={`tel:${SITE.mobile.tel}`}>{SITE.mobile.display}</a><small>{CALL_NOTE.mobile.pt}</small></div>
      <div class="phone"><a class="tel" href={`tel:${SITE.landlines[0].tel}`}>{SITE.landlines[0].display}</a><small>{CALL_NOTE.landline.pt}</small></div>
      <div class="phone"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
    </div>
  </div>
</section>
<style>
  .fin { padding-block: var(--sec); }
  .fin__grid { display: grid; gap: 3rem; align-items: end; }
  .fin h2 { font-size: clamp(2.3rem, 1.3rem + 3.2vw, 4.25rem); max-width: 14ch; }
  .fin .lead { margin: 1.25rem 0 2rem; }
  .fin__direct { display: grid; gap: 1.1rem; padding-top: 1.25rem; border-top: 1px solid var(--hair); }
  .fin__label { color: var(--fg-2); font-size: var(--t-small); }
  .fin__direct a { font-size: 1.3rem; display: inline-flex; min-height: 44px; align-items: center; }
  @media (min-width: 960px) { .fin__grid { grid-template-columns: 1.6fr 1fr; gap: 5rem; } }
</style>

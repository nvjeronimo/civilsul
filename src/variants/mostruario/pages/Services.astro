---
import Chip from '../Chip.astro';
import Swatch from '../Swatch.astro';
import Icon from '../Icon.astro';
import Trades from '../Trades.astro';
import Final from '../Final.astro';
import { UI, href } from '../../../lib/site';
import { SERVICES } from '../../../content/services';
import { leadSample, familySamples, TIPO } from '../samples';
import { C } from '../copy';
const V = 'mostruario' as const;
const u = UI.pt;
---
<header class="pagehead board">
  <div class="wrap">
    <ol class="crumbs"><li><a href={href(V, 'pt', 'home')}>{C.home}</a></li><li aria-current="page">{u.nav.services}</li></ol>
    <h1>{C.servicesPageH}</h1>
    <p class="lead">{C.servicesPageLead}</p>
    <nav class="jump" aria-label={u.nav.services}>
      <ul>
        {SERVICES.map((s) => <li><a href={`#${s.id}`}>{C.family[s.id]}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

{SERVICES.map((s, i) => {
  const lead = leadSample(s.id);
  const more = familySamples(s.id, s.works, 3);
  return (
    <section class:list={['sec fm', i % 2 ? 'lime fm--alt' : 'lime']} id={s.id} aria-labelledby={`h-${s.id}`}>
      <div class="wrap fm__grid">
        <div class="fm__text">
          <h2 id={`h-${s.id}`}><a href={href(V, 'pt', 'services', s.slug.pt)}>{s.title.pt}</a></h2>
          <p class="fm__intro">{s.intro.pt}</p>
          <h3 class="fm__sub">{C.items}</h3>
          <ul class="items">{s.items.map((it) => <li>{it.pt}</li>)}</ul>
          <div class="actions fm__act">
            <a class="btn btn--primary btn--sm" href={href(V, 'pt', 'services', s.slug.pt)}>{C.seeService}<Icon name="arrow" /></a>
            <a class="btn btn--sm" href={`${href(V, 'pt', 'quote')}?tipo=${TIPO[s.id]}`}>{u.nav.quote}</a>
          </div>
        </div>
        <div class="fm__samples">
          {lead ? <Chip sample={lead} ratio="wide" w={[720, 360]} dot={i === 0} /> : <Swatch title={C.family[s.id]} sub={C.publicSub} ratio="wide" />}
          {!lead && <p class="fm__none">{C.noRelated}</p>}
          {more.length > 0 && (
            <ul class="wall fm__more" aria-label={C.fromWorks}>
              {more.map((m) => <li><Chip sample={m} w={[225, 120]} /></li>)}
            </ul>
          )}
        </div>
      </div>
    </section>
  );
})}

<section class="sec lime" aria-labelledby="tr-h">
  <div class="wrap">
    <div class="sec__head">
      <h2 id="tr-h">{C.tradesH}</h2>
      <p class="lead">{C.tradesLead}</p>
    </div>
    <Trades />
  </div>
</section>

<Final />

<style>
  .jump { margin-top: 2.5rem; }
  .jump ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .jump a {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0.4rem 0.9rem;
    border: 1px solid var(--hair-2); color: var(--fg); font-weight: 560; font-size: var(--t-small); text-decoration: none;
  }
  .jump a:hover { border-color: var(--fg); }

  .fm { scroll-margin-top: 1rem; }
  .fm__grid { display: grid; gap: 2.5rem; align-items: start; }
  .fm__none { color: var(--fg-2); font-size: var(--t-small); max-width: 44ch; }
  .fm h2 { font-size: var(--t-h2); max-width: 16ch; }
  .fm h2 a { color: var(--fg); text-decoration: none; }
  .fm h2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .fm__intro { margin: 1.25rem 0 2rem; color: var(--fg-2); max-width: 60ch; }
  .fm__sub { font-size: 1rem; font-weight: 650; letter-spacing: 0; margin-bottom: 0.5rem; }
  .fm__act { margin-top: 2rem; }
  .fm__samples { display: grid; gap: 1.75rem; }
  .fm__more { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .fm__more :global(.chip__swap) { font-size: 0.875rem; }
  @media (max-width: 599.98px) {
    .fm__more { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .fm__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(3rem, 5vw, 5.5rem); }
    .fm--alt .fm__text { order: 2; }
    .fm__text { position: sticky; top: 2rem; }
  }
</style>

---
import { Picture } from 'astro:assets';
import Chip from '../Chip.astro';
import Icon from '../Icon.astro';
import Spec from '../Spec.astro';
import Process from '../Process.astro';
import Trades from '../Trades.astro';
import Final from '../Final.astro';
import { SITE, UI, href, whatsapp } from '../../../lib/site';
import { SERVICES } from '../../../content/services';
import { KINDS, workById } from '../../../content/works';
import { MISSION, TEAM } from '../../../content/company';
import { leadSample } from '../samples';
import { C } from '../copy';

const V = 'mostruario' as const;
const u = UI.pt;
const kindLabel = (k: string) => KINDS.find((x) => x.id === k)!.label.pt;

// Obras escolhidas para a secção de fotografias grandes (ordem = composição da grelha)
const picks: { id: string; photo?: number; shape: 'land' | 'port' | 'half' }[] = [
  { id: 'construcao-moradia', shape: 'land' },
  { id: 'fachada-portaldegenios', shape: 'port' },
  { id: 'topazmoment', shape: 'port' },
  { id: 'monte-do-pocinho', shape: 'land' },
  { id: 'arranjos-exteriores-piscina', shape: 'half' },
  { id: 'vale-del-rey', shape: 'half' },
];
---
<section class="hero board" aria-labelledby="hero-h">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-h">{C.heroH}</h1>
      <p class="lead">{C.heroLead}</p>
      <div class="actions">
        <a class="btn btn--primary" href={href(V, 'pt', 'quote')}><span class="dot" aria-hidden="true"></span>{u.nav.quote}</a>
        <a class="btn" href={whatsapp('pt')} rel="noopener" target="_blank"><Icon name="chat" />{C.heroWa}</a>
      </div>
      <p class="hero__facts"><span>{u.since}</span><span>{u.permit}</span><span>{SITE.address.city}, {SITE.address.region}</span></p>
    </div>
    <ul class="wall wall--row hero__wall" aria-label={C.wallLabel}>
      {SERVICES.map((s, i) => (
        <li><Chip sample={leadSample(s.id)} head={C.family[s.id]} w={[235, 265]} eager={i < 3} dot={i === 0} /></li>
      ))}
    </ul>
  </div>
</section>

<section class="sec board fams" aria-labelledby="fam-h">
  <div class="wrap">
    <div class="sec__head">
      <h2 id="fam-h">{C.servicesH}</h2>
      <p class="lead">{C.servicesLead}</p>
    </div>
    <ul class="fam">
      {SERVICES.map((s) => (
        <li>
          <span class="fam__ref">{C.ref} {leadSample(s.id).code}</span>
          <div class="fam__t">
            <h3><a href={href(V, 'pt', 'services', s.slug.pt)}>{s.title.pt}</a></h3>
            <p>{s.short.pt}</p>
          </div>
          <p class="fam__items">{s.items.map((it) => it.pt).join(' · ')}</p>
          <Icon name="arrow" class="fam__go" />
        </li>
      ))}
    </ul>
    <a class="more" href={href(V, 'pt', 'services')}>{u.allServices}<Icon name="arrow" /></a>
  </div>
</section>

<section class="sec lime" aria-labelledby="works-h">
  <div class="wrap">
    <div class="sec__head">
      <h2 id="works-h">{C.worksH}</h2>
      <p class="lead">{C.worksLead}</p>
    </div>
    <ul class="plates">
      {picks.map((p) => {
        const w = workById(p.id);
        const ph = w.photos[p.photo ?? 0];
        const sizes = p.shape === 'land' ? '(min-width: 900px) 62vw, 100vw' : p.shape === 'port' ? '(min-width: 900px) 30vw, 100vw' : '(min-width: 900px) 46vw, 100vw';
        return (
          <li class:list={['plate', `plate--${p.shape}`]}>
            <a href={href(V, 'pt', 'works', w.slug.pt)}>
              <span class="plate__img">
                <Picture src={ph.src} alt={ph.alt.pt} formats={['avif', 'webp']} widths={[600, 900, 1300, 1800]} sizes={sizes} loading="lazy" decoding="async" />
              </span>
              <span class="plate__cap">
                <span class="plate__t">{w.title.pt}</span>
                <span class="plate__m">{kindLabel(w.kind)}{w.place && ` · ${w.place}`}{w.client && ` · ${w.client}`}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    <a class="more" href={href(V, 'pt', 'works')}>{C.seeWorks}<Icon name="arrow" /></a>
  </div>
</section>

<section class="sec lime" aria-labelledby="co-h">
  <div class="wrap co">
    <div class="co__text">
      <h2 id="co-h">{C.companyH}</h2>
      <div class="prose">
        <p>{MISSION.pt}</p>
        <p>{TEAM.pt}</p>
      </div>
      <a class="more" href={href(V, 'pt', 'about')}>{C.aboutMore}<Icon name="arrow" /></a>
    </div>
    <Spec />
  </div>
</section>

<section class="sec lime" aria-labelledby="pr-h">
  <div class="wrap">
    <div class="sec__head"><h2 id="pr-h">{C.processH}</h2></div>
    <Process />
  </div>
</section>

<section class="sec lime" aria-labelledby="tr-h">
  <div class="wrap">
    <div class="sec__head">
      <h2 id="tr-h">{C.tradesH}</h2>
      <p class="lead">{C.tradesLead}</p>
    </div>
    <Trades />
  </div>
</section>

<Final />

<style>
  .hero { padding-block: clamp(2.5rem, 1rem + 4vw, 4.5rem) clamp(3rem, 1.5rem + 4vw, 5rem); }
  .hero__grid { display: grid; gap: 3rem; align-items: center; }
  .hero h1 { font-size: var(--t-hero); letter-spacing: -0.04em; line-height: 0.98; max-width: 14ch; }
  .hero .lead { margin: 1.5rem 0 2rem; max-width: 34em; }
  .hero__facts { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: 2.25rem; padding-top: 0.9rem; border-top: 1px solid var(--hair); font-size: var(--t-tag); color: var(--fg-2); }
  .hero__facts span + span { position: relative; }
  @media (min-width: 1100px) {
    .hero { min-height: calc(100svh - var(--head-h)); display: grid; align-items: center; }
    .hero__grid { grid-template-columns: minmax(0, 5.6fr) minmax(0, 6.4fr); gap: clamp(3rem, 4.5vw, 4.5rem); }
  }

  .fams { border-top: 1px solid var(--hair); }
  .fam { margin-bottom: 2rem; border-top: 1px solid var(--hair-2); }
  .fam li {
    position: relative; display: grid; gap: 0.5rem 2rem; padding: 1.5rem 0; border-bottom: 1px solid var(--hair);
    grid-template-columns: 1fr auto; align-items: start;
  }
  .fam__ref { grid-column: 1 / -1; font-size: var(--t-tag); color: var(--fg-2); }
  .fam__t h3 { font-size: var(--t-h3); }
  .fam__t h3 a { color: var(--fg); text-decoration: none; }
  .fam__t h3 a::after { content: ''; position: absolute; inset: 0; }
  .fam__t p { margin-top: 0.35rem; color: var(--fg-2); }
  .fam__items { grid-column: 1; font-size: var(--t-small); color: var(--fg-2); }
  .fam__go { grid-row: 2; grid-column: 2; width: 1.5rem; height: 1.5rem; color: var(--fg-2); transition: transform 400ms var(--ease), color 200ms; }
  .fam li:hover .fam__go, .fam li:focus-within .fam__go { transform: translateX(4px); color: var(--fg); }
  .fam li:hover h3 a { text-decoration: underline; text-decoration-thickness: 1px; }
  .fam li:has(a:focus-visible) { outline: 2px solid var(--ring); outline-offset: 4px; }
  .fam a:focus-visible { outline: none; }
  @media (min-width: 900px) {
    .fam li { grid-template-columns: 7.5rem minmax(0, 1.1fr) minmax(0, 1fr) auto; align-items: baseline; padding: 1.75rem 0; }
    .fam__ref { grid-column: 1; }
    .fam__items { grid-column: 3; }
    .fam__go { grid-row: 1; grid-column: 4; align-self: center; }
  }

  .plates { display: grid; gap: 2.5rem 1.5rem; margin-bottom: 2.5rem; }
  .plate a { display: grid; gap: 0.8rem; color: var(--fg); text-decoration: none; }
  .plate__img { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 3; background: var(--lime-2); }
  .plate--port .plate__img { aspect-ratio: 4 / 5; }
  .plate__img :global(picture), .plate__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .plate__img :global(img) { transition: transform 900ms var(--ease); }
  .plate a:hover .plate__img :global(img) { transform: scale(1.02); }
  .plate__cap { display: grid; gap: 0.15rem; padding-top: 0.6rem; border-top: 1px solid var(--hair); }
  .plate__t { font-weight: 650; font-size: 1.125rem; line-height: 1.3; letter-spacing: -0.01em; }
  .plate a:hover .plate__t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .plate__m { font-size: var(--t-tag); color: var(--fg-2); }
  @media (min-width: 900px) {
    .plates { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .plate--land { grid-column: span 8; }
    .plate--land .plate__img { aspect-ratio: 16 / 10.4; }
    .plate--port { grid-column: span 4; }
    .plate--half { grid-column: span 6; }
  }

  .co { display: grid; gap: 3rem; align-items: start; }
  .co h2 { font-size: var(--t-h2); margin-bottom: 1.5rem; }
  .co .prose { color: var(--fg-2); }
  .co .more { margin-top: 1.25rem; }
  @media (min-width: 960px) { .co { grid-template-columns: 1.1fr 1fr; gap: 5rem; } }
</style>

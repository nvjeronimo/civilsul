---
import Chip from '../Chip.astro';
import Swatch from '../Swatch.astro';
import Icon from '../Icon.astro';
import Final from '../Final.astro';
import { UI, href, whatsapp } from '../../../lib/site';
import { SERVICES, serviceById } from '../../../content/services';
import { leadSample, sampleForWork, TIPO } from '../samples';
import { C } from '../copy';
interface Props { id: string }
const { id } = Astro.props;
const V = 'mostruario' as const;
const u = UI.pt;
const s = serviceById(id);
const lead = leadSample(id);
const related = s.works.map(sampleForWork);
const others = SERVICES.filter((x) => x.id !== id);
const quote = `${href(V, 'pt', 'quote')}?tipo=${TIPO[id]}`;
---
<header class="pagehead board sv">
  <div class="wrap sv__grid">
    <div>
      <ol class="crumbs">
        <li><a href={href(V, 'pt', 'home')}>{C.home}</a></li>
        <li><a href={href(V, 'pt', 'services')}>{u.nav.services}</a></li>
        <li aria-current="page">{C.family[id]}</li>
      </ol>
      <h1>{s.title.pt}</h1>
      <p class="lead">{s.intro.pt}</p>
      <div class="actions sv__act">
        <a class="btn btn--primary" href={quote}><span class="dot" aria-hidden="true"></span>{C.askThis}</a>
        <a class="btn" href={whatsapp('pt')} rel="noopener" target="_blank"><Icon name="chat" />{C.heroWa}</a>
      </div>
    </div>
    <div class="sv__lead">
      {lead ? <Chip sample={lead} w={[440, 360]} eager dot /> : <Swatch title={C.family[id]} sub={C.publicSub} />}
    </div>
  </div>
</header>

<section class="sec lime" aria-labelledby="inc-h">
  <div class="wrap sv__body">
    <div>
      <h2 id="inc-h" class="sv__h2">{C.items}</h2>
      <ul class="items">{s.items.map((it) => <li>{it.pt}</li>)}</ul>
    </div>
    <div>
      <h2 class="sv__h2" id="rel-h">{u.related}</h2>
      {related.length > 0 ? (
        <ul class="wall sv__wall" aria-labelledby="rel-h">
          {related.map((r) => <li><Chip sample={r} ratio="pt" w={[250, 170]} open /></li>)}
        </ul>
      ) : (
        <p class="sv__none">{C.noRelated}</p>
      )}
    </div>
  </div>
</section>

<section class="sec lime" aria-labelledby="oth-h">
  <div class="wrap">
    <h2 id="oth-h" class="sv__h2">{C.otherServices}</h2>
    <ul class="oth">
      {others.map((o) => (
        <li><a href={href(V, 'pt', 'services', o.slug.pt)}><span>{o.title.pt}</span><Icon name="arrow" /></a></li>
      ))}
    </ul>
  </div>
</section>

<Final tipo={TIPO[id]} />

<style>
  .sv__grid { display: grid; gap: 2.5rem; align-items: end; }
  .sv h1 { max-width: 16ch; }
  .sv__act { margin-top: 2rem; }
  .sv__lead { max-width: 26rem; }
  @media (min-width: 1000px) {
    .sv__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 5rem; }
    .sv__lead { justify-self: end; width: 100%; }
  }
  .sv__body { display: grid; gap: 3.5rem; }
  .sv__h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); margin-bottom: 1.5rem; }
  .sv__wall { gap: 1.75rem 1.25rem; }
  @media (max-width: 699.98px) { .sv__wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .sv__body { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 5rem; } }
  .oth { display: grid; border-top: 1px solid var(--hair-2); }
  .oth a {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem; min-height: 64px; padding: 0.75rem 0;
    border-bottom: 1px solid var(--hair); color: var(--fg); font-weight: 620; font-size: 1.15rem; text-decoration: none;
  }
  .sv__none { color: var(--fg-2); max-width: 52ch; padding-top: 1rem; border-top: 1px solid var(--hair); }
  .oth .ic { color: var(--fg-2); transition: transform 400ms var(--ease); }
  .oth a:hover span:nth-child(1) { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .oth a:hover .ic { transform: translateX(4px); color: var(--fg); }
  @media (min-width: 900px) { .oth { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
</style>

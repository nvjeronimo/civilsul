---
// Ícones da variante Mostruário: traço 1.6, pontas redondas, grelha 24. Desenhados, sem glifos.
type Name = 'phone' | 'chat' | 'mail' | 'arrow' | 'arrow-left' | 'menu' | 'close' | 'pin' | 'check';
interface Props { name: Name; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class:list={['ic', cls]} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="M5.2 3.8h3.3l1.6 4.3-2.1 1.4a11 11 0 0 0 6.5 6.5l1.4-2.1 4.3 1.6v3.3a1.6 1.6 0 0 1-1.7 1.6A16.2 16.2 0 0 1 3.6 5.5a1.6 1.6 0 0 1 1.6-1.7Z" />}
  {name === 'chat' && <><path d="M4.3 19.7 5.5 16A7.9 7.9 0 1 1 8.3 18.6Z" /><path d="M9 10.6h6M9 13.4h3.8" /></>}
  {name === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="1" /><path d="m4.2 6.5 7.8 6 7.8-6" /></>}
  {name === 'arrow' && <path d="M4.5 12h14.5M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'arrow-left' && <path d="M19.5 12H5M10.5 6.5 5 12l5.5 5.5" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'pin' && <><path d="M12 21s-6.3-5.8-6.3-10.8a6.3 6.3 0 0 1 12.6 0C18.3 15.2 12 21 12 21Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>

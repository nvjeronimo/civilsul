---
import { TRADES } from '../../content/services';
---
<ul class="trades">
  {TRADES.map((t) => <li>{t.pt}</li>)}
</ul>
<style>
  .trades { columns: 1; column-gap: 2.5rem; }
  .trades li { break-inside: avoid; display: flex; align-items: baseline; gap: 0.75rem; padding: 0.7rem 0; border-bottom: 1px solid var(--hair); font-weight: 520; }
  .trades li::before { content: ''; flex: none; width: 0.45rem; height: 0.45rem; border-radius: 50%; border: 1px solid var(--fg-2); transform: translateY(-0.1em); }
  @media (min-width: 640px) { .trades { columns: 2; } }
  @media (min-width: 1000px) { .trades { columns: 3; } }
</style>

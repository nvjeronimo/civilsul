---
import Layout from '../Layout.astro';
import Board from '../components/Board.astro';
import Hoarding from '../components/Hoarding.astro';
import BlankBoard from '../components/BlankBoard.astro';
import { UI, type Lang } from '../../../lib/site';
import { WORKS, KINDS } from '../../../content/works';
import { copy } from '../copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang);
const ui = UI[lang];
// Ordem pensada para o tapume: cada fiada de quatro módulos fica cheia.
const order = ['vale-del-rey', 'maison-amarande', 'topazmoment', 'monte-do-pocinho', 'fachada-portaldegenios', 'reconstrucao-edificio', 'construcao-moradia', 'arranjos-exteriores-piscina', 'remodelacao-apartamento', 'remodelacao-moradia', 'reconstrucao-ampliacao-moradia', 'remodelacao-ampliacao-moradia', 'arranjos-exteriores-terraco'];
const works = order.map((id) => WORKS.find((w) => w.id === id)!).concat(WORKS.filter((w) => !order.includes(w.id)));
---
<Layout lang={lang} page="works">
  <div class="wrap page-top">
    <div class="works-top">
      <Board as="header" band={`${c.aviso} · ${ui.nav.works}`} size="lg" class="page-head">
        <h1>{c.worksH1}</h1>
        <p class="lead">{c.worksIntro}</p>
      </Board>
      <Board as="div" size="sm" class="filter-board" data-js-only bolt={false}>
        <div class="filter" role="group" aria-labelledby="filtro-label" data-filter-group>
          <span class="flabel" id="filtro-label">{c.filterLabel}</span>
          <div class="filter__btns">
            <button type="button" aria-pressed="true" data-filter="all">{c.all}</button>
            {KINDS.map((k) => <button type="button" aria-pressed="false" data-filter={k.id}>{k.label[lang]}</button>)}
          </div>
          <p class="visually-hidden" aria-live="polite" data-filter-status data-prefix={c.showing}></p>
        </div>
      </Board>
    </div>
  </div>

  <section class="stretch works-list" aria-label={c.worksH1}>
    <div class="wrap">
      <Hoarding works={works} lang={lang} headingLevel="h2" id="tapume" />
    </div>
  </section>

  <section class="stretch">
    <div class="wrap">
      <BlankBoard lang={lang} />
    </div>
  </section>
</Layout>

<script>
  import '../scripts/filter.ts';
</script>

<style>
  .works-top { display: grid; gap: 1.5rem; align-items: end; }
  .works-top .lead { margin-top: 1.25rem; max-width: 52ch; }
  .filter { display: grid; gap: 0.75rem; }
  .filter__btns { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter button {
    min-height: 44px;
    padding: 0.45rem 0.9rem 0.35rem;
    background: var(--enamel);
    color: var(--ink);
    border: 2px solid var(--ink);
    font: inherit; font-weight: 800; font-size: 1rem;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out);
  }
  .filter button:hover { background: var(--hoarding); }
  .filter button[aria-pressed='true'] { background: var(--ink); color: var(--enamel); }
  .works-list { padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  @media (min-width: 64rem) {
    .works-top { grid-template-columns: 1.2fr 1fr; }
  }
</style>

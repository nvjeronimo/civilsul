---
import Layout from '../Layout.astro';
import Board from '../components/Board.astro';
import Icon from '../components/Icon.astro';
import ContactFields from '../components/ContactFields.astro';
import { SITE, UI, href, type Lang } from '../../../lib/site';
import { INVITE } from '../../../content/company';
import { copy } from '../copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang);
const ui = UI[lang];
---
<Layout lang={lang} page="contact">
  <div class="wrap page-top">
    <div class="contact">
      <Board as="header" band={`${c.aviso} · Civilsul · ${ui.permit}`} size="lg" class="contact__head">
        <h1>{c.contactH1}</h1>
        <p class="lead">{INVITE[lang]}</p>
        <div class="actions contact__actions">
          <a class="hazard" href={href('aviso', lang, 'quote')}><span>{ui.nav.quote}<Icon name="arrow" /></span></a>
        </div>
        <p class="contact__alt">{c.contactCta}</p>
        <dl class="fields contact__facts">
          <div><dt class="flabel">{c.field.contractor}</dt><dd class="fvalue">{SITE.legalName}</dd></div>
          <div><dt class="flabel">{c.field.permit}</dt><dd class="fvalue">{SITE.permit}</dd></div>
          <div><dt class="flabel">{c.field.area}</dt><dd class="fvalue">{ui.area}</dd></div>
        </dl>
      </Board>
      <Board as="section" band={c.contactsTitle} bandAs="h2" bandId="canais" size="lg" aria-labelledby="canais">
        <ContactFields lang={lang} />
      </Board>
    </div>
  </div>
</Layout>

<style>
  .contact { display: grid; gap: 1.5rem; padding-bottom: 1rem; }
  .contact .lead { margin-top: 1.1rem; }
  .contact__actions { margin-top: 1.75rem; }
  .contact__alt { margin-top: 0.75rem; color: var(--ink-3); font-size: 0.9375rem; }
  .contact__facts { margin-top: 2rem; border-top: 2px solid var(--ink); }
  .contact__facts > div:first-child { padding-top: 0.85rem; }
  @media (min-width: 64rem) {
    .contact { grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  }
</style>

---
import Layout from '../Layout.astro';
import Board from '../components/Board.astro';
import Icon from '../components/Icon.astro';
import TradesBoard from '../components/TradesBoard.astro';
import BlankBoard from '../components/BlankBoard.astro';
import { UI, href, type Lang } from '../../../lib/site';
import { SERVICES } from '../../../content/services';
import { copy } from '../copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang);
const ui = UI[lang];
---
<Layout lang={lang} page="services">
  <div class="wrap page-top stack">
    <Board as="header" band={`${c.aviso} · ${ui.nav.services}`} size="lg" class="page-head">
      <h1>{c.servicesH1}</h1>
      <p class="lead measure">{c.servicesIntro}</p>
    </Board>

    {SERVICES.map((s) => (
      <Board as="article" band={s.title[lang]} bandAs="h2" bandId={`s-${s.id}`} aria-labelledby={`s-${s.id}`}>
        <div class="svc">
          <div class="svc__text">
            <p class="svc__short">{s.short[lang]}</p>
            <p>{s.intro[lang]}</p>
            <a class="arrow-link" href={href('aviso', lang, 'services', s.slug[lang])}><span>{c.seeService}: {s.title[lang]}</span><Icon name="arrow" size={20} /></a>
          </div>
          <div class="svc__items">
            <h3 class="flabel">{ui.includes}</h3>
            <ul>
              {s.items.map((it) => <li>{it[lang]}</li>)}
            </ul>
          </div>
        </div>
      </Board>
    ))}

    <TradesBoard lang={lang} />
    <BlankBoard lang={lang} />
  </div>
</Layout>

<style>
  .stack { display: grid; gap: clamp(1.75rem, 1.2rem + 2vw, 3rem); padding-bottom: 1rem; }
  .page-top :global(.page-head) h1 { max-width: 20ch; }
  .page-top :global(.page-head) .lead { margin-top: 1.25rem; }
  .svc { display: grid; gap: 2rem; }
  .svc__text { display: grid; gap: 1rem; align-content: start; max-width: 64ch; }
  .svc__text p + p { margin-top: 0; }
  .svc__short { font-size: var(--fs-h3); font-weight: 800; line-height: 1.25; letter-spacing: -0.01em; }
  .svc__items ul { margin-top: 0.75rem; border-top: 2px solid var(--ink); }
  .svc__items li {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule-soft);
    font-weight: 700;
  }
  @media (min-width: 56rem) {
    .svc { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
  }
</style>

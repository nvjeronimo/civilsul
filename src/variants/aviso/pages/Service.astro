---
import { Picture } from 'astro:assets';
import Layout from '../Layout.astro';
import Board from '../components/Board.astro';
import Icon from '../components/Icon.astro';
import Hoarding from '../components/Hoarding.astro';
import BlankBoard from '../components/BlankBoard.astro';
import { SITE, UI, BASE, href, type Lang } from '../../../lib/site';
import { SERVICES, serviceById } from '../../../content/services';
import { workById } from '../../../content/works';
import { copy, SERVICE_TO_TYPE } from '../copy';

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const c = copy(lang);
const ui = UI[lang];
const s = serviceById(id);
const works = s.works.map(workById);
const lead = works[0].photos[0];
const others = SERVICES.filter((x) => x.id !== id);
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title[lang],
    description: s.intro[lang],
    serviceType: s.title[lang],
    areaServed: { '@type': 'AdministrativeArea', name: 'Algarve' },
    provider: { '@id': abs(`${BASE}aviso/#empresa`), name: SITE.name },
    url: abs(href('aviso', lang, 'services', s.slug[lang])),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: c.breadcrumbHome, item: abs(href('aviso', lang, 'home')) },
      { '@type': 'ListItem', position: 2, name: ui.nav.services, item: abs(href('aviso', lang, 'services')) },
      { '@type': 'ListItem', position: 3, name: s.title[lang], item: abs(href('aviso', lang, 'services', s.slug[lang])) },
    ],
  },
];
---
<Layout lang={lang} page="services" id={id} jsonLd={jsonLd}>
  <div class="wrap page-top">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('aviso', lang, 'services')}><Icon name="arrow-left" size={18} /><span>{ui.allServices}</span></a>
    </nav>
    <div class="svc-hero">
      <figure class="svc-hero__lona">
        <Picture
          src={lead.src}
          alt={lead.alt[lang]}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 64rem) 58vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <Board as="header" band={`${c.aviso} · ${ui.nav.services}`} size="lg" class="svc-hero__board">
        <h1>{s.title[lang]}</h1>
        <p class="lead">{s.intro[lang]}</p>
      </Board>
    </div>
  </div>

  <section class="stretch" aria-labelledby="inclui">
    <div class="wrap">
      <Board as="div" band={ui.includes} bandAs="h2" bandId="inclui">
        <ul class="items">
          {s.items.map((it) => (
            <li><Icon name="check" size={22} />{it[lang]}</li>
          ))}
        </ul>
      </Board>
    </div>
  </section>

  <section class="stretch" aria-labelledby="relacionadas">
    <div class="wrap">
      <Board as="div" size="sm" class="rel-plate">
        <h2 id="relacionadas">{ui.related}</h2>
      </Board>
      <Hoarding works={works} lang={lang} />
    </div>
  </section>

  <section class="stretch">
    <div class="wrap stack">
      <BlankBoard lang={lang} title={c.serviceCtaTitle} text={c.serviceCtaText} tipo={SERVICE_TO_TYPE[id]} />
      <Board as="nav" band={c.otherServices} aria-label={c.otherServices}>
        <ul class="others">
          {others.map((o) => (
            <li>
              <a href={href('aviso', lang, 'services', o.slug[lang])}>
                <span><strong>{o.title[lang]}</strong><span>{o.short[lang]}</span></span>
                <Icon name="arrow" size={22} />
              </a>
            </li>
          ))}
        </ul>
      </Board>
    </div>
  </section>
</Layout>

<style>
  .crumbs { margin-bottom: 1.25rem; }
  .crumbs a {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px;
    padding: 0 0.9rem 0 0.7rem;
    background: var(--enamel); border: 2px solid var(--ink);
    color: var(--ink); font-weight: 800; text-decoration: none;
  }
  .crumbs a:hover { background: var(--ink); color: var(--enamel); }

  .svc-hero { display: grid; }
  .svc-hero__lona {
    margin: 0;
    padding: 12px;
    background: var(--hem);
    border: 1px solid rgb(0 0 0 / 0.14);
    box-shadow: var(--shadow-sm);
    aspect-ratio: 4 / 3;
  }
  .svc-hero__lona :global(picture), .svc-hero__lona :global(img) { height: 100%; }
  .svc-hero__lona :global(img) { object-fit: cover; }
  .svc-hero :global(.svc-hero__board) { margin-top: -3rem; margin-inline: 0.75rem; }
  .svc-hero .lead { margin-top: 1.25rem; }
  @media (min-width: 64rem) {
    .svc-hero { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; }
    .svc-hero__lona { grid-column: 5 / -1; grid-row: 1; aspect-ratio: 16 / 11; }
    .svc-hero :global(.svc-hero__board) { grid-column: 1 / 8; grid-row: 1; margin: 0; z-index: 2; }
  }

  .items { display: grid; gap: 0; }
  .items li {
    display: flex; gap: 0.75rem; align-items: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule-soft);
    font-size: 1.1875rem; font-weight: 700;
  }
  .items li :global(svg) { flex: none; color: var(--blue-ink); }
  @media (min-width: 48rem) { .items { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }

  .stretch :global(.rel-plate) { display: inline-block; margin-bottom: 1.5rem; }
  .stretch :global(.rel-plate) h2 { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem); padding-inline: 0.5rem; }

  .stack { display: grid; gap: clamp(1.75rem, 1.2rem + 2vw, 3rem); }
  .others { display: grid; }
  .others li { border-bottom: 1px solid var(--rule-soft); }
  .others a {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 4rem; padding: 0.8rem 0;
    color: var(--ink); text-decoration: none;
  }
  .others a > span { display: grid; gap: 0.15rem; }
  .others strong { font-size: 1.1875rem; font-weight: 800; }
  .others a > span > span { color: var(--ink-2); }
  .others :global(svg) { flex: none; color: var(--blue-ink); }
  .others a:hover strong { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  @media (min-width: 56rem) { .others { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
</style>

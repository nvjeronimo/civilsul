---
import Layout from '../Layout.astro';
import Board from '../components/Board.astro';
import { type Lang } from '../../../lib/site';
import { PRIVACY } from '../../../content/privacy';
import { copy } from '../copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang);
---
<Layout lang={lang} page="privacy">
  <div class="wrap page-top">
    <Board as="article" band={`${c.aviso} · ${c.privacyH1}`} size="lg" class="priv">
      <h1>{c.privacyH1}</h1>
      <div class="priv__blocks">
        {PRIVACY[lang].map((b) => (
          <section>
            <h2>{b.h}</h2>
            {b.p.map((p) => <p>{p}</p>)}
          </section>
        ))}
      </div>
    </Board>
  </div>
</Layout>

<style>
  .page-top :global(.priv) { max-width: 52rem; }
  .priv h1 { font-size: clamp(2.1rem, 1.5rem + 2.4vw, 3.5rem); }
  .priv__blocks { margin-top: 2rem; border-top: 2px solid var(--ink); }
  .priv__blocks section { padding-block: 1.4rem; border-bottom: 1px solid var(--rule-soft); }
  .priv__blocks section:last-child { border-bottom: 0; padding-bottom: 0; }
  .priv h2 { font-size: 1.3125rem; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 0.6rem; }
  .priv p { max-width: 66ch; color: var(--ink-2); }
</style>

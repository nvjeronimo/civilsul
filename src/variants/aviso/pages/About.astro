---
import Layout from '../Layout.astro';
import Board from '../components/Board.astro';
import Icon from '../components/Icon.astro';
import ProcessBoard from '../components/ProcessBoard.astro';
import TradesBoard from '../components/TradesBoard.astro';
import BlankBoard from '../components/BlankBoard.astro';
import { Picture } from 'astro:assets';
import { SITE, UI, href, type Lang } from '../../../lib/site';
import { MISSION, WHO, TEAM, TAGLINE } from '../../../content/company';
import { workById } from '../../../content/works';
import { copy } from '../copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang);
const ui = UI[lang];
const photo = workById('monte-do-pocinho').photos[0];
---
<Layout lang={lang} page="about">
  <div class="wrap page-top">
    <div class="about-hero">
      <figure class="about-hero__lona">
        <Picture src={photo.src} alt={photo.alt[lang]} formats={['avif', 'webp']} widths={[640, 960, 1400, 1920]} sizes="(min-width: 64rem) 62vw, 100vw" loading="eager" fetchpriority="high" />
      </figure>
      <Board as="header" band={`${c.aviso} · ${ui.nav.about}`} size="lg" class="about-hero__board">
        <h1>{c.aboutH1}</h1>
        <p class="lead">{c.aboutLead}</p>
        <dl class="about-facts">
          <div><dt class="flabel">{c.field.permit}</dt><dd>{SITE.permit}</dd></div>
          <div><dt class="flabel">{c.field.since}</dt><dd>{SITE.since}</dd></div>
        </dl>
      </Board>
    </div>
  </div>

  <section class="stretch">
    <div class="wrap about-grid">
      <Board as="section" band={c.missionTitle} bandAs="h2" bandId="missao" aria-labelledby="missao">
        <p class="big-text">{MISSION[lang]}</p>
        <p class="tagline">{TAGLINE[lang]}</p>
      </Board>
      <Board as="section" band={c.teamTitle} bandAs="h2" bandId="equipa" aria-labelledby="equipa">
        <p class="big-text">{TEAM[lang]}</p>
      </Board>
      <Board as="section" band={c.whereTitle} bandAs="h2" bandId="onde" aria-labelledby="onde" class="span-2">
        <div class="where">
          <p class="big-text">{WHO[lang]}</p>
          <dl class="fields">
            <div><dt class="flabel">{c.field.contractor}</dt><dd class="fvalue">{SITE.legalName}</dd></div>
            <div><dt class="flabel">{c.field.seat}</dt><dd class="fvalue">{SITE.address.street}<br />{SITE.address.postal} {SITE.address.city}, {SITE.address.region}</dd></div>
            <div><dt class="flabel">{c.field.area}</dt><dd class="fvalue">{ui.area}</dd></div>
            <div><dt class="flabel">{ui.address}</dt><dd class="fvalue"><a class="arrow-link" href={SITE.mapsUrl} rel="noopener"><span>{ui.directions}</span><Icon name="external" size={18} /></a></dd></div>
          </dl>
        </div>
      </Board>
    </div>
  </section>

  <section class="stretch">
    <div class="wrap stack">
      <ProcessBoard lang={lang} />
      <TradesBoard lang={lang} />
      <BlankBoard lang={lang} />
    </div>
  </section>
</Layout>

<style>
  .about-hero { display: grid; }
  .about-hero__lona {
    margin: 0; padding: 12px;
    background: var(--hem); border: 1px solid rgb(0 0 0 / 0.14); box-shadow: var(--shadow-sm);
    aspect-ratio: 4 / 3;
  }
  .about-hero__lona :global(picture), .about-hero__lona :global(img) { height: 100%; }
  .about-hero__lona :global(img) { object-fit: cover; }
  .about-hero :global(.about-hero__board) { margin: -3rem 0.75rem 0; }
  .about-hero .lead { margin-top: 1.1rem; }
  .about-facts { display: grid; grid-template-columns: 1fr 1fr; margin-top: 1.75rem; border-top: 2px solid var(--ink); }
  .about-facts div { padding-top: 0.85rem; }
  .about-facts div + div { padding-left: 1.25rem; border-left: 1px solid var(--rule-soft); }
  .about-facts dd { font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3.25rem); font-weight: 900; letter-spacing: -0.03em; line-height: 1; margin-top: 0.3rem; }
  @media (min-width: 64rem) {
    .about-hero { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; }
    .about-hero__lona { grid-column: 1 / 9; grid-row: 1; aspect-ratio: 16 / 11; }
    .about-hero :global(.about-hero__board) { grid-column: 7 / -1; grid-row: 1; margin: 0; z-index: 2; }
  }

  .about-grid { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .big-text { font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem); line-height: 1.55; max-width: 62ch; }
  .tagline { margin-top: 1.25rem; font-weight: 850; font-size: 1.25rem; }
  .where { display: grid; gap: 2rem; }
  @media (min-width: 56rem) {
    .about-grid { grid-template-columns: 1fr 1fr; }
    .about-grid > :global(.span-2) { grid-column: 1 / -1; }
    .where { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  .stack { display: grid; gap: clamp(2rem, 1.4rem + 2vw, 3.5rem); }
</style>

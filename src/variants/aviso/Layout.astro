---
import '@fontsource-variable/overpass/wght.css';
import './styles.css';
import Head from '../../components/Head.astro';
import Logo from '../../components/Logo.astro';
import Board from './components/Board.astro';
import Icon from './components/Icon.astro';
import { SITE, BASE, UI, CALL_NOTE, href, tel, whatsapp, type Lang, type PageKey } from '../../lib/site';
import { altPath } from '../../lib/routes';
import { meta } from '../../lib/meta';
import { copy } from './copy';

interface Props {
  lang: Lang;
  page: PageKey;
  id?: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  overHero?: boolean;
}
const { lang, page, id, image, jsonLd = [], overHero = false } = Astro.props;
const m = meta({ lang, page, id });
const ui = UI[lang];
const c = copy(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const switchHref = BASE + 'aviso/' + altPath(page, id, other);
const nav: { key: PageKey; label: string }[] = [
  { key: 'services', label: ui.nav.services },
  { key: 'works', label: ui.nav.works },
  { key: 'about', label: ui.nav.about },
  { key: 'contact', label: ui.nav.contact },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-PT' : 'en'} class="v-aviso">
  <head>
    <Head title={m.title} description={m.description} lang={lang} variant="aviso" page={page} id={id} image={image} jsonLd={jsonLd} themeColor="#dcdeda" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#conteudo">{ui.skip}</a>

    <header class:list={['site-head', { 'is-over': overHero }]} data-menu>
      <div class="wrap">
        <div class="strip">
          <span class="strip__screws" aria-hidden="true">
            <svg viewBox="0 0 16 16" focusable="false"><circle cx="8" cy="8" r="7" fill="#d4d6d2" stroke="#111" stroke-width="1.3" /><path d="M3.3 8h9.4" stroke="#111" stroke-width="1.8" transform="rotate(30 8 8)" /></svg>
            <svg viewBox="0 0 16 16" focusable="false"><circle cx="8" cy="8" r="7" fill="#d4d6d2" stroke="#111" stroke-width="1.3" /><path d="M3.3 8h9.4" stroke="#111" stroke-width="1.8" transform="rotate(-45 8 8)" /></svg>
          </span>
          <a class="brand" href={href('aviso', lang, 'home')}>
            <Logo size="2.1rem" title="Civilsul" />
            <span class="brand__name" aria-hidden="true">Civilsul</span>
          </a>
          <button class="menu-btn" type="button" aria-expanded="false" aria-controls="aviso-nav" data-menu-btn data-js-only>
            <span class="menu-btn__open"><Icon name="menu" /></span>
            <span class="menu-btn__close"><Icon name="close" /></span>
            <span class="menu-btn__label" data-open-label={ui.menu} data-close-label={ui.close}>{ui.menu}</span>
          </button>
          <div class="strip__nav" id="aviso-nav" data-menu-panel>
            <nav aria-label={c.menuLabel}>
              <ul class="nav">
                {nav.map((n) => (
                  <li><a href={href('aviso', lang, n.key)} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a></li>
                ))}
              </ul>
            </nav>
            <a class="lang" href={switchHref} hreflang={other === 'pt' ? 'pt-PT' : 'en'} lang={other === 'pt' ? 'pt-PT' : 'en'}>
              <span class="lang__code" aria-hidden="true">{other.toUpperCase()}</span><span class="lang__name">{ui.langSwitch}</span>
            </a>
            <a class="head-phone" href={tel(SITE.mobile.tel)}>
              <Icon name="phone" size={20} />
              <span><span class="head-phone__num">{SITE.mobile.display}</span><small>{CALL_NOTE.mobile[lang]}</small></span>
            </a>
            <a class="hazard hazard--sm" href={href('aviso', lang, 'quote')} aria-current={page === 'quote' ? 'page' : undefined}><span>{ui.nav.quote}</span></a>
          </div>
        </div>
      </div>
    </header>

    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <Board as="div" band={c.band} size="lg" bolt={false} class="foot-board">
          <div class="foot-grid">
            <div class="foot-id">
              <Logo size="3rem" title="Civilsul" />
              <dl class="fields foot-fields">
                <div><dt class="flabel">{c.field.contractor}</dt><dd class="fvalue">{SITE.legalName}</dd></div>
                <div><dt class="flabel">{c.field.permit}</dt><dd class="fvalue">{SITE.permit}</dd></div>
                <div><dt class="flabel">{c.field.since}</dt><dd class="fvalue">{SITE.since}</dd></div>
                <div>
                  <dt class="flabel">{c.field.seat}</dt>
                  <dd class="fvalue foot-addr">{SITE.address.street}<br />{SITE.address.postal} {SITE.address.city}, {SITE.address.region}</dd>
                </div>
              </dl>
            </div>
            <div class="foot-contacts">
              <h2 class="foot-h">{c.contactsTitle}</h2>
              <ul class="foot-list">
                <li>
                  <span class="flabel">{c.field.mobile}</span>
                  <a href={tel(SITE.mobile.tel)}>{SITE.mobile.display}</a>
                  <small class="note">{CALL_NOTE.mobile[lang]}</small>
                </li>
                {SITE.landlines.map((l) => (
                  <li>
                    <span class="flabel">{c.field.landline}</span>
                    <a href={tel(l.tel)}>{l.display}</a>
                    <small class="note">{CALL_NOTE.landline[lang]}</small>
                  </li>
                ))}
                <li>
                  <span class="flabel">{c.field.email}</span>
                  <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
                </li>
                <li>
                  <span class="flabel">{c.field.whatsapp}</span>
                  <a href={whatsapp(lang)} rel="noopener">{SITE.mobile.display}</a>
                </li>
              </ul>
            </div>
            <nav class="foot-nav" aria-label={c.footerNav}>
              <h2 class="foot-h">{c.footerNav}</h2>
              <ul>
                <li><a href={href('aviso', lang, 'home')}>{c.breadcrumbHome}</a></li>
                {nav.map((n) => <li><a href={href('aviso', lang, n.key)}>{n.label}</a></li>)}
                <li><a href={href('aviso', lang, 'quote')}>{ui.nav.quote}</a></li>
                <li><a href={href('aviso', lang, 'privacy')}>{ui.privacy}</a></li>
                <li><a href={switchHref} hreflang={other === 'pt' ? 'pt-PT' : 'en'} lang={other === 'pt' ? 'pt-PT' : 'en'}>{ui.langSwitch}</a></li>
              </ul>
            </nav>
          </div>
          <div class="foot-base">
            <p>© {year} {SITE.legalName} {ui.rights}</p>
            <a href={BASE}>{ui.demo}</a>
          </div>
        </Board>
      </div>
    </footer>

    <nav class="action-bar" aria-label={c.navLabel}>
      <a href={tel(SITE.mobile.tel)} class="action-bar__item">
        <Icon name="phone" size={22} /><span>{ui.call}</span>
      </a>
      <a href={whatsapp(lang)} class="action-bar__item" rel="noopener">
        <Icon name="whatsapp" size={22} /><span>{ui.whatsapp}</span>
      </a>
      <a href={href('aviso', lang, 'quote')} class="action-bar__item action-bar__quote" aria-current={page === 'quote' ? 'page' : undefined}>
        <span class="action-bar__plate"><Icon name="form" size={22} /><span>{c.quoteShort}</span></span>
      </a>
    </nav>

    <script>
      import './scripts/site.ts';
    </script>
  </body>
</html>

<style>
  /* ---------- Cabeçalho: faixa branca aparafusada ---------- */
  .site-head { position: relative; z-index: 30; padding-top: 14px; }
  .site-head.is-over { position: absolute; top: 0; left: 0; right: 0; }
  .strip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 0.5rem 2.75rem;
    background: var(--enamel);
    border: 2px solid var(--ink);
    box-shadow: var(--shadow-sm);
  }
  .strip__screws svg { position: absolute; top: 50%; width: 22px; height: 22px; margin-top: -11px; }
  .strip__screws svg:first-child { left: 10px; }
  .strip__screws svg:last-child { right: 10px; }

  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .brand__name { font-size: 1.5rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1; padding-top: 0.15em; }

  .strip__nav { display: flex; align-items: center; gap: 1.25rem; }
  .nav { display: flex; gap: 0.25rem; }
  .nav a {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 0 0.7rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 3px solid transparent;
    padding-top: 3px;
  }
  .nav a:hover { border-bottom-color: var(--rule-soft); }
  .nav a[aria-current='page'] { border-bottom-color: var(--blue); }

  .lang {
    display: inline-flex; align-items: center; gap: 0.4rem;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .lang__code {
    display: inline-grid; place-items: center;
    min-width: 2.1rem; height: 1.6rem;
    border: 2px solid var(--ink);
    font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.04em;
    padding-top: 2px;
  }
  .lang__name { display: none; }
  .lang:hover .lang__code { background: var(--ink); color: var(--enamel); }

  .head-phone {
    display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.1;
  }
  .head-phone__num { display: block; font-weight: 800; font-size: 1.0625rem; }
  .head-phone small { display: block; font-size: 0.6875rem; color: var(--ink-3); margin-top: 1px; }
  .head-phone:hover .head-phone__num { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }

  .hazard--sm { min-height: 3rem; padding: 5px; --stripe: 8px; }
  .hazard--sm > span { font-size: 1rem; padding: 0.45rem 0.9rem; }

  .menu-btn {
    display: none;
    align-items: center; gap: 0.45rem;
    min-height: 44px; min-width: 44px;
    padding: 0 0.85rem;
    background: var(--enamel);
    color: var(--ink);
    border: 2px solid var(--ink);
    font: inherit; font-weight: 800;
    cursor: pointer;
  }
  .menu-btn__close { display: none; }
  [data-open] .menu-btn__open { display: none; }
  [data-open] .menu-btn__close { display: block; }
  [data-open] .menu-btn { background: var(--ink); color: var(--enamel); }

  @media (max-width: 79.99rem) {
    .head-phone small { display: none; }
  }
  @media (max-width: 71.99rem) and (min-width: 64rem) {
    .head-phone span { display: none; }
  }

  @media (max-width: 63.99rem) {
    .site-head { padding-top: 10px; }
    .strip { padding: 0.35rem 0.5rem 0.35rem 2.6rem; min-height: 3.75rem; }
    .brand__name { font-size: 1.3rem; }
    .menu-btn { display: inline-flex; margin-right: 1.9rem; }
    .strip__nav {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: -2px; right: -2px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.75rem 1.5rem 1.5rem;
      background: var(--enamel);
      border: 2px solid var(--ink);
      box-shadow: var(--shadow);
    }
    [data-open] .strip__nav { display: flex; }
    .nav { flex-direction: column; gap: 0; }
    .nav a { min-height: 3.25rem; font-size: 1.375rem; font-weight: 800; padding: 0; border-bottom: 1px solid var(--rule-soft); width: 100%; }
    .nav a[aria-current='page'] { border-bottom: 1px solid var(--rule-soft); box-shadow: inset 4px 0 0 var(--blue); padding-left: 0.85rem; }
    .lang { min-height: 3.25rem; border-bottom: 1px solid var(--rule-soft); }
    .lang__name { display: inline; }
    .head-phone { min-height: 3.5rem; margin-block: 0.5rem 0.75rem; }
    .head-phone span, .head-phone small { display: block; }
    .hazard--sm { min-height: 3.5rem; }
  }
  @media (max-width: 63.99rem) and (scripting: none) {
    .strip { flex-wrap: wrap; }
    .strip__nav { display: flex; position: static; border: 0; box-shadow: none; padding: 0 0 0.75rem; width: 100%; }
  }

  /* ---------- Rodapé ---------- */
  .site-foot { padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2rem, 1rem + 3vw, 4rem); }
  .foot-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .foot-grid { grid-template-columns: 1.1fr 1fr; }
    .foot-nav { grid-column: 1 / -1; }
  }
  @media (min-width: 72rem) {
    .foot-grid { grid-template-columns: 1.15fr 1fr 0.7fr; }
    .foot-nav { grid-column: auto; }
  }
  .foot-fields { margin-top: 1.5rem; }
  .foot-addr { font-size: 1.0625rem; }
  .foot-h { font-size: 1.25rem; font-weight: 850; letter-spacing: -0.01em; margin-bottom: 1rem; }
  .foot-list { display: grid; gap: 1rem; }
  .foot-list li { display: grid; gap: 0.15rem; }
  .foot-list a {
    display: inline-flex; align-items: center; min-height: 44px; width: fit-content;
    font-size: 1.25rem; font-weight: 800; color: var(--ink); text-decoration: none;
  }
  .foot-list .flabel + a { margin-top: -0.35rem; margin-bottom: -0.35rem; }
  .foot-list a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .foot-nav ul { display: grid; gap: 0; }
  @media (min-width: 48rem) and (max-width: 71.99rem) {
    .foot-nav ul { grid-template-columns: repeat(4, auto); justify-content: start; column-gap: 2rem; }
  }
  .foot-nav a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; color: var(--ink); }
  .foot-base {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .foot-base a { display: inline-flex; align-items: center; min-height: 44px; margin-block: -0.6rem; font-weight: 700; }

  /* ---------- Barra fixa de ações (telemóvel) ---------- */
  .action-bar { display: none; }
  @media (max-width: 47.99rem) {
    :global(body) { padding-bottom: calc(4.5rem + env(safe-area-inset-bottom)); }
    .action-bar {
      display: grid;
      grid-template-columns: 1fr 1fr 1.25fr;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      background: var(--enamel);
      border-top: 2px solid var(--ink);
      padding-bottom: env(safe-area-inset-bottom);
      box-shadow: 0 -6px 18px -10px rgb(0 0 0 / 0.4);
    }
    .action-bar__item {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem;
      min-height: 4.25rem;
      color: var(--ink);
      font-weight: 800; font-size: 0.875rem;
      text-decoration: none;
      border-right: 1px solid var(--rule-soft);
    }
    .action-bar__quote {
      border-right: 0;
      padding: 6px;
      background: repeating-linear-gradient(-45deg, var(--ink) 0 8px, var(--yellow) 8px 16px);
    }
    .action-bar__plate {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem;
      width: 100%; height: 100%;
      background: var(--yellow);
      border: 2px solid var(--ink);
    }
  }
</style>

---
// Todos os canais, cada número com a nota de custo da chamada.
import Icon from './Icon.astro';
import { SITE, UI, CALL_NOTE, tel, whatsapp, type Lang } from '../../../lib/site';
import { copy } from '../copy';
interface Props { lang: Lang; withAddress?: boolean }
const { lang, withAddress = true } = Astro.props;
const c = copy(lang);
const ui = UI[lang];
---
<ul class="channels">
  <li>
    <Icon name="mobile" size={26} />
    <div>
      <span class="flabel">{c.field.mobile}</span>
      <a class="big" href={tel(SITE.mobile.tel)}>{SITE.mobile.display}</a>
      <small class="note">{CALL_NOTE.mobile[lang]}</small>
    </div>
  </li>
  <li>
    <Icon name="whatsapp" size={26} />
    <div>
      <span class="flabel">{c.field.whatsapp}</span>
      <a class="big" href={whatsapp(lang)} rel="noopener">{SITE.mobile.display}</a>
      <small class="note">{CALL_NOTE.mobile[lang]}</small>
    </div>
  </li>
  {SITE.landlines.map((l) => (
    <li>
      <Icon name="phone" size={26} />
      <div>
        <span class="flabel">{c.field.landline}</span>
        <a class="big" href={tel(l.tel)}>{l.display}</a>
        <small class="note">{CALL_NOTE.landline[lang]}</small>
      </div>
    </li>
  ))}
  <li>
    <Icon name="mail" size={26} />
    <div>
      <span class="flabel">{c.field.email}</span>
      <a class="big" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </li>
  {withAddress && (
    <li>
      <Icon name="pin" size={26} />
      <div>
        <span class="flabel">{c.field.address}</span>
        <address class="addr">{SITE.address.street}<br />{SITE.address.postal} {SITE.address.city}, {SITE.address.region}</address>
        <a class="arrow-link" href={SITE.mapsUrl} rel="noopener"><span>{ui.directions}</span><Icon name="external" size={18} /></a>
      </div>
    </li>
  )}
</ul>

<style>
  .channels { display: grid; gap: 0; }
  .channels li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--rule-soft);
  }
  .channels li:first-child { border-top: 0; padding-top: 0; }
  .channels li > :global(svg) { margin-top: 0.1rem; color: var(--ink); }
  .big {
    display: inline-flex; align-items: center;
    min-height: 44px;
    margin-block: -0.2rem;
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .big:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .addr { font-style: normal; font-weight: 700; font-size: 1.125rem; line-height: 1.4; margin-top: 0.3rem; }
</style>

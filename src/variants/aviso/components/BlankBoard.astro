---
// O aviso em branco da obra do visitante: convite ao pedido de orçamento.
import Board from './Board.astro';
import Icon from './Icon.astro';
import { href, type Lang } from '../../../lib/site';
import { copy } from '../copy';
interface Props { lang: Lang; title?: string; text?: string; tipo?: string; headingId?: string }
const { lang, title, text, tipo, headingId = 'aviso-em-branco' } = Astro.props;
const c = copy(lang);
const to = href('aviso', lang, 'quote') + (tipo ? `?tipo=${tipo}` : '');
---
<Board as="section" size="lg" class="blank" aria-labelledby={headingId}>
  <div class="blank__grid">
    <div>
      <h2 id={headingId}>{title ?? c.blankTitle}</h2>
      <p class="lead blank__lead">{text ?? c.blankLead}</p>
      <div class="actions blank__actions">
        <a class="hazard" href={to}><span>{c.blankCta}<Icon name="arrow" /></span></a>
      </div>
      <slot />
    </div>
    <dl class="blank__fields" aria-hidden="true">
      {c.blankFields.map((f) => (
        <div><dt class="flabel">{f}</dt><dd></dd></div>
      ))}
    </dl>
  </div>
</Board>

<style>
  .blank__grid { display: grid; gap: 2.5rem; }
  .blank__lead { margin-top: 1rem; max-width: 46ch; }
  .blank__actions { margin-top: 1.75rem; }
  .blank__fields { display: grid; gap: 1.1rem; align-content: center; }
  .blank__fields dd {
    height: 2.25rem;
    border-bottom: 2px dashed var(--ink-3);
  }
  @media (min-width: 56rem) {
    .blank__grid { grid-template-columns: 1.15fr 1fr; align-items: center; gap: 4rem; }
  }
  @media (max-width: 40rem) {
    .blank__fields { display: none; }
    .blank__actions .hazard { width: 100%; }
  }
</style>

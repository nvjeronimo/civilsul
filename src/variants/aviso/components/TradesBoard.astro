---
import Board from './Board.astro';
import { TRADES } from '../../../content/services';
import type { Lang } from '../../../lib/site';
import { copy } from '../copy';
interface Props { lang: Lang; id?: string }
const { lang, id = 'oficios' } = Astro.props;
const c = copy(lang);
---
<Board as="section" band={c.tradesTitle} bandAs="h2" bandId={id} aria-labelledby={id}>
  <p class="lead-sm">{c.tradesLead}</p>
  <ul class="trades">
    {TRADES.map((t) => <li>{t[lang]}</li>)}
  </ul>
</Board>

<style>
  .lead-sm { color: var(--ink-2); max-width: 60ch; }
  .trades {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2rem;
    border-top: 2px solid var(--ink);
  }
  .trades li {
    display: flex; align-items: baseline; gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule-soft);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .trades li::before {
    content: '';
    flex: none;
    width: 0.55rem; height: 0.55rem;
    background: var(--ink);
    transform: translateY(-0.1em);
  }
  @media (min-width: 40rem) { .trades { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .trades { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

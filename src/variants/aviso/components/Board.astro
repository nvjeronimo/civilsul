---
// Placa de esmalte branco, contorno a tinta, quatro parafusos desenhados nos cantos.
// band: faixa azul de cabeçalho (como nas placas municipais). bolt: assenta à primeira vista.
interface Props {
  as?: 'section' | 'article' | 'div' | 'aside' | 'header' | 'footer' | 'nav';
  band?: string;
  bandAs?: 'p' | 'h2' | 'h3';
  bandId?: string;
  class?: string;
  bolt?: boolean;
  size?: 'lg' | 'md' | 'sm';
  [key: string]: unknown;
}
const { as: Tag = 'div', band, bandAs: BandTag = 'p', bandId, class: cls, bolt = true, size = 'md', ...rest } = Astro.props;
const hasBand = Boolean(band) || Astro.slots.has('band');
const angles = [23, -38, 64, -12];
---
<Tag class:list={['board', `board--${size}`, cls, { 'has-band': hasBand }]} data-bolt={bolt ? '' : undefined} {...rest}>
  <span class="screws" aria-hidden="true">
    {angles.map((r, i) => (
      <svg class={`screw screw--${i}`} viewBox="0 0 16 16" style={`--r:${r}deg;transform:rotate(${r}deg)`} focusable="false">
        <circle cx="8" cy="8" r="7" fill="#d4d6d2" stroke="#111" stroke-width="1.2" />
        <path d="M3.4 5.2 A5.3 5.3 0 0 1 10.8 3.5" fill="none" stroke="#fff" stroke-width="1.1" opacity=".85" />
        <path d="M3.3 8h9.4" stroke="#111" stroke-width="1.7" stroke-linecap="square" />
      </svg>
    ))}
  </span>
  {hasBand && (
    <BandTag class="band" id={bandId}>
      <slot name="band">{band}</slot>
    </BandTag>
  )}
  <div class="board__body">
    <slot />
  </div>
</Tag>

<style>
  .board {
    position: relative;
    background: var(--enamel);
    border: 2px solid var(--ink);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  /* espessura da chapa: filete interior do esmalte + aresta com sombra suave */
  .board::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid rgb(17 17 17 / 0.22);
    pointer-events: none;
    z-index: 1;
  }
  .board__body { padding: var(--board-pad); }
  .board--sm .board__body { padding: 2rem 2.6rem 1.85rem; }
  .board--lg .board__body { padding: clamp(2rem, 1.3rem + 2.6vw, 3.5rem); }
  .has-band .board__body { padding-top: calc(var(--board-pad) * 0.8); }

  .screws { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .screw { position: absolute; width: 26px; height: 26px; transform-box: fill-box; transform-origin: 50% 50%; }
  .screw--0 { top: 9px; left: 9px; }
  .screw--1 { top: 9px; right: 9px; }
  .screw--2 { bottom: 9px; left: 9px; }
  .screw--3 { bottom: 9px; right: 9px; }
  .board--sm .screw { width: 20px; height: 20px; }
  .board--sm .screw--0, .board--sm .screw--2 { left: 6px; }
  .board--sm .screw--1, .board--sm .screw--3 { right: 6px; }
  .board--sm .screw--0, .board--sm .screw--1 { top: 6px; }
  .board--sm .screw--2, .board--sm .screw--3 { bottom: 6px; }

  .band {
    margin: 0;
    background: var(--blue);
    color: #fff;
    border-bottom: 2px solid var(--ink);
    padding: 0.8rem calc(var(--board-pad) + 0.25rem) 0.7rem;
    padding-inline: max(calc(var(--board-pad) + 0.25rem), 3rem);
    font-size: clamp(1.1875rem, 1.1rem + 0.35vw, 1.375rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .band :global(a) { color: #fff; }
  .board--sm .band { font-size: 1.1875rem; padding: 0.6rem 2.25rem 0.5rem; }
</style>

---
// Lona impressa esticada no tapume: bainha clara com ilhós, fotografia, e uma pequena placa de legenda aparafusada.
import { Picture } from 'astro:assets';
import type { Work } from '../../../content/works';
import { KINDS } from '../../../content/works';
import { href, type Lang } from '../../../lib/site';

interface Props { work: Work; lang: Lang; sizes: string; headingLevel?: 'h2' | 'h3'; eager?: boolean }
const { work, lang, sizes, headingLevel: H = 'h3', eager = false } = Astro.props;
const photo = work.photos[0];
const landscape = photo.src.width > photo.src.height;
const kind = KINDS.find((k) => k.id === work.kind)!.label[lang];
---
<a class:list={['lona', landscape ? 'is-land' : 'is-port']} href={href('aviso', lang, 'works', work.slug[lang])}>
  <span class="lona__photo">
    <Picture
      src={photo.src}
      alt={photo.alt[lang]}
      formats={['avif', 'webp']}
      widths={landscape ? [480, 760, 1100, 1500] : [360, 560, 800]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </span>
  <span class="tag">
    <svg class="tag__screw tag__screw--l" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7" fill="#d4d6d2" stroke="#111" stroke-width="1.4" /><path d="M3.3 8h9.4" stroke="#111" stroke-width="1.8" transform="rotate(35 8 8)" /></svg>
    <svg class="tag__screw tag__screw--r" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7" fill="#d4d6d2" stroke="#111" stroke-width="1.4" /><path d="M3.3 8h9.4" stroke="#111" stroke-width="1.8" transform="rotate(-20 8 8)" /></svg>
    <H class="tag__title">{work.title[lang]}</H>
    <span class="tag__meta">{kind}{work.place ? ` · ${work.place}` : ''}</span>
  </span>
</a>

<style>
  .lona {
    position: relative;
    display: block;
    padding: 12px;
    background: var(--hem);
    border: 1px solid rgb(0 0 0 / 0.14);
    box-shadow: var(--shadow-sm);
    color: var(--ink);
    text-decoration: none;
    height: 100%;
  }
  /* ilhós na bainha: cantos + ao longo do topo e da base */
  .lona::before, .lona::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 12px;
    pointer-events: none;
    background:
      radial-gradient(circle at calc(100% - 6px) 6px, #fff 0 1.6px, #8b8f8a 1.8px 3.2px, #4c504b 3.4px 3.9px, transparent 4.2px) no-repeat,
      radial-gradient(circle at 6px 6px, #fff 0 1.6px, #8b8f8a 1.8px 3.2px, #4c504b 3.4px 3.9px, transparent 4.2px) 0 0 / 96px 12px repeat-x;
  }
  .lona::before { top: 0; }
  .lona::after { bottom: 0; }

  .lona__photo {
    display: block;
    overflow: hidden;
    height: 100%;
    background: var(--hoarding-rib);
  }
  .lona__photo :global(picture) { height: 100%; }
  .lona__photo :global(img) {
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .lona:hover .lona__photo :global(img) { transform: scale(1.025); }

  .tag {
    position: absolute;
    left: 24px;
    bottom: 24px;
    max-width: min(26rem, calc(100% - 48px));
    background: var(--enamel);
    border: 2px solid var(--ink);
    box-shadow: var(--shadow-sm);
    padding: 0.7rem 2.35rem 0.75rem;
  }
  .tag__screw { position: absolute; top: 50%; width: 18px; height: 18px; margin-top: -9px; }
  .tag__screw--l { left: 7px; }
  .tag__screw--r { right: 7px; }
  .tag__meta { display: block; margin-top: 0.2rem; font-size: 0.875rem; line-height: 1.3; color: var(--ink-3); }
  .tag__title {
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .lona:hover .tag__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .lona:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  @media (max-width: 40rem) {
    .lona { padding: 10px; }
    .tag { left: 16px; right: 16px; bottom: 16px; max-width: none; }
  }
</style>

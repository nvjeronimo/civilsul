---
// O tapume das obras: lonas lado a lado, paisagem ocupa dois módulos, retrato um.
import Lona from './Lona.astro';
import type { Work } from '../../../content/works';
import type { Lang } from '../../../lib/site';
interface Props { works: Work[]; lang: Lang; headingLevel?: 'h2' | 'h3'; id?: string; label?: string }
const { works, lang, headingLevel = 'h3', id, label } = Astro.props;
---
<ul class="hoarding" id={id} aria-label={label}>
  {works.map((w) => {
    const land = w.photos[0].src.width > w.photos[0].src.height;
    return (
      <li class:list={[land ? 'is-land' : 'is-port']} data-kind={w.kind}>
        <Lona work={w} lang={lang} headingLevel={headingLevel} sizes={land ? '(min-width: 64rem) 46vw, (min-width: 40rem) 92vw, 100vw' : '(min-width: 64rem) 23vw, (min-width: 40rem) 46vw, 100vw'} />
      </li>
    );
  })}
</ul>

<style>
  .hoarding {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 0.6rem + 1.4vw, 1.75rem);
  }
  .hoarding > li { min-width: 0; }
  .hoarding > li[hidden] { display: none; }
  .is-land { aspect-ratio: 4 / 3; }
  .is-port { aspect-ratio: 4 / 5; }

  @media (min-width: 40rem) {
    .hoarding {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(20rem, 44vw, 27rem);
      grid-auto-flow: dense;
    }
    .is-land { grid-column: span 2; aspect-ratio: auto; }
    .is-port { aspect-ratio: auto; }
  }
  @media (min-width: 64rem) {
    .hoarding {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(19rem, 27vw, 26rem);
    }
  }
</style>

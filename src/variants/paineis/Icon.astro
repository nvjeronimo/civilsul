---
// Ícones desenhados para a variante (traço 1.5, pontas redondas, 24×24). Sem glifos unicode.
interface Props { name: 'phone' | 'chat' | 'mail' | 'pin' | 'arrow' | 'arrow-left' | 'menu' | 'close' | 'plus' | 'check' | 'listen' | 'rule' | 'team'; class?: string; size?: number }
const { name, class: cls, size = 20 } = Astro.props;
---
<svg class:list={['ic', cls]} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="M5.2 3.5h3l1.7 4.3-2.2 1.4a11.5 11.5 0 0 0 7.1 7.1l1.4-2.2 4.3 1.7v3a1.6 1.6 0 0 1-1.7 1.6A17 17 0 0 1 3.6 5.2a1.6 1.6 0 0 1 1.6-1.7Z" />}
  {name === 'chat' && <path d="M20.5 11.6a8.3 8.3 0 0 1-12.2 7.3L3.5 20.5l1.6-4.6a8.3 8.3 0 1 1 15.4-4.3Z" />}
  {name === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4.2 7 7.8 5.8L19.8 7" /></>}
  {name === 'pin' && <><path d="M12 21s6.8-6 6.8-11.2a6.8 6.8 0 1 0-13.6 0C5.2 15 12 21 12 21Z" /><circle cx="12" cy="9.8" r="2.4" /></>}
  {name === 'arrow' && <path d="M4.5 12h15M13.5 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19.5 12h-15M10.5 6l-6 6 6 6" />}
  {name === 'menu' && <path d="M4 8.5h16M4 15.5h16" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'plus' && <path d="M12 6.5v11M6.5 12h11" />}
  {name === 'check' && <path d="m5.5 12.5 4.2 4.2 8.8-9.4" />}
  {name === 'listen' && <><rect x="3" y="4" width="11" height="9" rx="2.5" /><path d="M6.5 13v3l3.2-3" /><rect x="10" y="10.5" width="11" height="8" rx="2.5" /><path d="M17.5 18.5v2.2l-2.6-2.2" /></>}
  {name === 'rule' && <><path d="M3.5 20.5 20.5 3.5v17Z" /><path d="M11.5 16.5h5v-5Z" /><path d="M6.8 17.2v1.6M9.6 14.4v1.6" /></>}
  {name === 'team' && <><circle cx="8.5" cy="8" r="3.2" /><path d="M2.8 19.5a5.7 5.7 0 0 1 11.4 0" /><circle cx="17" cy="9.2" r="2.5" /><path d="M16.2 14.6a4.6 4.6 0 0 1 5 4.9" /></>}
</svg>

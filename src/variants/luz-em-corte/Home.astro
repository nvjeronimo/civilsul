---
// Candidata B "Luz em Corte": a página inicial lida como um corte de arquitetura.
// Lajes a carvão separam os pisos (secções), paredes enquadram as fotografias, e uma banda de sol
// atravessa a página com o scroll. Só PT, só página inicial.
import '@fontsource-variable/sofia-sans-condensed/wght.css';
import '@fontsource-variable/sofia-sans/wght.css';
import './styles.css';
import { Picture } from 'astro:assets';
import Head from '../../components/Head.astro';
import Logo from '../../components/Logo.astro';
import Corte from './Corte.astro';
import Icon from './Icon.astro';
import { SITE, BASE, UI, CALL_NOTE, whatsapp, tel } from '../../lib/site';
import { meta } from '../../lib/meta';
import { SERVICES, TRADES } from '../../content/services';
import { workById, type Work } from '../../content/works';
import { MISSION, WHO, TEAM, INVITE, PROCESS } from '../../content/company';

const V = 'luz-em-corte' as const;
const u = UI.pt;
const m = meta({ lang: 'pt', page: 'home' });
const year = new Date().getFullYear();
const wa = whatsapp('pt');
const mail = `mailto:${SITE.email}?subject=${encodeURIComponent('Pedido de orçamento')}`;

const hero = workById('vale-del-rey');

// Os pisos da secção de obras: cada piso é uma fila de divisões (span em 12 colunas).
type Room = { w: Work; span: number; tall?: boolean };
const floors: Room[][] = [
  [{ w: workById('construcao-moradia'), span: 8 }, { w: workById('reconstrucao-edificio'), span: 4, tall: true }],
  [{ w: workById('monte-do-pocinho'), span: 5 }, { w: workById('fachada-portaldegenios'), span: 3, tall: true }, { w: workById('reconstrucao-ampliacao-moradia'), span: 4 }],
  [{ w: workById('maison-amarande'), span: 3, tall: true }, { w: workById('arranjos-exteriores-piscina'), span: 5 }, { w: workById('topazmoment'), span: 4, tall: true }],
];
const note = (w: Work) => [w.place, w.client].filter(Boolean).join(' · ');

const nav = [
  { id: 'servicos', label: u.nav.services },
  { id: 'obras', label: u.nav.works },
  { id: 'empresa', label: u.nav.about },
  { id: 'contactos', label: u.nav.contact },
];
---
<html lang="pt-PT" class="lc">
  <head>
    <Head title={m.title} description={m.description} lang="pt" variant={V} page="home" langs={['pt']} themeColor="#F4F4F1" />
  </head>
  <body>
    <a class="skip" href="#main">{u.skip}</a>

    <div class="sun" aria-hidden="true" data-sun><i class="sun__soft"></i><i class="sun__warm"></i></div>

    <header class="hd">
      <div class="wrap hd__row">
        <a class="hd__brand" href="#main" aria-label="Civilsul, início da página">
          <Logo size="2rem" />
          <span>Civilsul</span>
        </a>
        <nav class="hd__nav" aria-label="Secções da página">
          <ul>{nav.map((n) => <li><a href={`#${n.id}`}>{n.label}</a></li>)}</ul>
        </nav>
        <div class="hd__phone">
          <a class="num" href={tel(SITE.mobile.tel)}>{SITE.mobile.display}</a>
          <small>{CALL_NOTE.mobile.pt}</small>
        </div>
        <a class="btn btn--lit hd__cta" href="#contactos">{u.nav.quote}</a>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero wrap" aria-labelledby="hero-t">
        <div class="hero__text">
          <h1 id="hero-t">Construímos, reconstruímos e remodelamos no Algarve desde 1985.</h1>
          <p class="hero__lead">Moradias de raiz, casas antigas refeitas e ampliadas, apartamentos remodelados, piscinas e obras públicas. A mesma empresa acompanha a obra da estrutura aos acabamentos.</p>
          <div class="hero__act">
            <a class="btn btn--lit" href="#contactos">{u.nav.quote}<Icon name="arrow" /></a>
            <a class="btn btn--line" href={wa} rel="noopener" target="_blank"><Icon name="chat" />{u.whatsapp}</a>
          </div>
        </div>
        <figure class="hero__draw">
          <Corte photo={hero.photos[0].src} alt={hero.photos[0].alt.pt} />
          <figcaption>Corte ilustrativo, sem escala. No piso térreo, a {hero.title.pt.charAt(0).toLowerCase() + hero.title.pt.slice(1)}.</figcaption>
        </figure>
        <p class="facts"><span>{u.since}</span><span>{u.permit}</span><span>{SITE.address.city}, {SITE.address.region}</span></p>
      </section>

      <div class="slab" aria-hidden="true"></div>

      <section class="svc wrap" id="servicos" aria-labelledby="svc-t">
        <div class="svc__head">
          <h2 id="svc-t">Das fundações aos acabamentos, a mesma equipa.</h2>
          <p>Seis frentes de trabalho, todas feitas pela Civilsul. Para uma casa nova, uma ampliação ou uma reparação no telhado, fala sempre com a mesma empresa.</p>
        </div>
        <ul class="svc__list">
          {SERVICES.map((s) => (
            <li class="svc__row">
              <h3>{s.title.pt}</h3>
              <p class="svc__short">{s.short.pt}</p>
              <ul class="svc__items">{s.items.map((i) => <li>{i.pt}</li>)}</ul>
            </li>
          ))}
        </ul>
        <div class="trades" id="trabalhos">
          <h3>Lista completa de trabalhos</h3>
          <ul>{TRADES.map((t) => <li>{t.pt}</li>)}</ul>
        </div>
      </section>

      <section class="works" id="obras" aria-labelledby="works-t">
        <div class="wrap works__head">
          <h2 id="works-t">Casas construídas, refeitas e remodeladas.</h2>
          <p>Fotografias de obras terminadas pela Civilsul: moradias novas, reconstruções com ampliação, uma fachada preservada, interiores e exteriores.</p>
        </div>
        <div class="wrap">
          <div class="section">
            {floors.map((floor) => (
              <ul class="floor">
                {floor.map(({ w, span, tall }) => (
                  <li class:list={['room', tall && 'room--tall']} style={`--span:${span}`}>
                    <figure>
                      <div class="room__photo">
                        <Picture
                          src={w.photos[0].src}
                          alt={w.photos[0].alt.pt}
                          formats={['avif', 'webp']}
                          widths={[480, 800, 1200, 1600]}
                          sizes={`(min-width: 960px) ${Math.round((span / 12) * 94)}vw, 100vw`}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <figcaption>
                        <span class="room__t">{w.title.pt}</span>
                        {note(w) && <span class="room__n">{note(w)}</span>}
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </section>

      <section class="co wrap" id="empresa" aria-labelledby="co-t">
        <div class="co__main">
          <h2 id="co-t">Uma construtora com alvará desde 1985.</h2>
          <p class="co__lead">{MISSION.pt}</p>
        </div>
        <div class="co__side">
          <dl class="co__facts">
            <div><dt>Empresa</dt><dd>{SITE.legalName}</dd></div>
            <div><dt>Alvará</dt><dd class="num">nº {SITE.permit}</dd></div>
            <div><dt>Em atividade</dt><dd class="num">desde {SITE.since}</dd></div>
            <div><dt>Sede</dt><dd>{SITE.address.city}, {SITE.address.region}</dd></div>
            <div><dt>Onde trabalha</dt><dd>{u.area}</dd></div>
          </dl>
          <p>{WHO.pt}</p>
          <p>{TEAM.pt}</p>
        </div>
      </section>

      <section class="proc wrap" aria-labelledby="proc-t">
        <h2 id="proc-t">Como começa uma obra connosco.</h2>
        <ol class="proc__list">
          {PROCESS.map((p) => (
            <li>
              <h3>{p.title.pt}</h3>
              <p>{p.text.pt}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="ct" id="contactos" aria-labelledby="ct-t">
        <div class="wrap ct__grid">
          <div class="ct__main">
            <h2 id="ct-t">Fale connosco sobre a sua obra.</h2>
            <p class="ct__lead">{INVITE.pt}</p>
            <p class="ct__hint">Diga-nos o tipo de obra, onde fica e para quando a quer. Fotografias ou plantas ajudam a preparar a primeira conversa.</p>
            <div class="ct__act">
              <a class="btn btn--lit btn--rev" href={wa} rel="noopener" target="_blank"><Icon name="chat" />Pedir orçamento por WhatsApp</a>
              <a class="btn btn--line btn--line-rev" href={mail}><Icon name="mail" />Pedir por email</a>
            </div>
          </div>
          <dl class="ct__chan">
            <div>
              <dt>Telemóvel</dt>
              <dd><a class="num ct__tel" href={tel(SITE.mobile.tel)}>{SITE.mobile.display}</a><small>{CALL_NOTE.mobile.pt}</small></dd>
            </div>
            {SITE.landlines.map((l) => (
              <div>
                <dt>Telefone fixo</dt>
                <dd><a class="num ct__tel" href={tel(l.tel)}>{l.display}</a><small>{CALL_NOTE.landline.pt}</small></dd>
              </div>
            ))}
            <div>
              <dt>{u.email}</dt>
              <dd><a class="ct__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            </div>
            <div>
              <dt>{u.address}</dt>
              <dd>
                <address>{SITE.address.street}<br /><span class="num">{SITE.address.postal}</span> {SITE.address.city}, {SITE.address.region}</address>
                <a class="ct__map" href={SITE.mapsUrl} rel="noopener" target="_blank"><Icon name="pin" />{u.directions}</a>
              </dd>
            </div>
          </dl>
        </div>
      </section>
    </main>

    <footer class="ft">
      <div class="wrap ft__row">
        <p class="ft__id"><Logo tone="reverse" size="1.6rem" /><span><strong>{SITE.legalName}</strong> · {u.permit} · {u.since}</span></p>
        <ul class="ft__links">
          {nav.map((n) => <li><a href={`#${n.id}`}>{n.label}</a></li>)}
          <li><a href={wa} rel="noopener" target="_blank">{u.whatsapp}</a></li>
          <li><a href={`mailto:${SITE.email}`}>{u.email}</a></li>
        </ul>
        <p class="ft__demo"><a href={BASE}>{u.demo}</a><span>© {year} {SITE.name}</span></p>
      </div>
    </footer>

    <nav class="bar" aria-label="Contacto rápido">
      <a href={tel(SITE.mobile.tel)} aria-label={`${u.call} ${SITE.mobile.display} (${CALL_NOTE.mobile.pt})`}><Icon name="phone" />{u.call}</a>
      <a href={wa} rel="noopener" target="_blank"><Icon name="chat" />{u.whatsapp}</a>
      <a class="bar__q" href="#contactos">Orçamento</a>
    </nav>

    <script>
      import './sun.ts';
    </script>
  </body>
</html>

---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import PageIntro from '../PageIntro.astro';
import WorkCard from '../WorkCard.astro';
import QuoteBand from '../QuoteBand.astro';
import { UI, href, whatsapp, type Lang } from '../../../lib/site';
import { SERVICES, serviceById } from '../../../content/services';
import { workById } from '../../../content/works';
import { C, V, SERVICE_PHOTO, SERVICE_QUOTE } from '../copy';

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const ui = UI[lang];
const s = serviceById(id);
const works = s.works.filter((id) => id !== SERVICE_PHOTO[s.id]).map(workById);
const lead = workById(SERVICE_PHOTO[s.id]).photos[0];
const tipo = SERVICE_QUOTE[s.id];
const others = SERVICES.filter((x) => x.id !== s.id);
---
<PageIntro lang={lang} title={s.title[lang]} lead={s.intro[lang]} crumbs={[{ label: ui.nav.services, href: href(V, lang, 'services') }]}>
  <div class="btn-row intro-cta">
    <a class="btn btn--primary" href={`${href(V, lang, 'quote')}?tipo=${tipo}`}>{C.quoteForThis[lang]}<Icon name="arrow-right" size={18} /></a>
    <a class="btn btn--line" href={whatsapp(lang)} target="_blank" rel="noopener"><Icon name="chat" size={20} />{C.whatsappCta[lang]}</a>
  </div>
  <div slot="media" class="ph lead-ph">
    <Picture src={lead.src} formats={['avif', 'webp']} widths={[640, 960, 1280, 1600]} sizes="(min-width: 64rem) 46vw, 100vw" alt={lead.alt[lang]} loading="eager" fetchpriority="high" decoding="async" />
  </div>
</PageIntro>

<section class="section section--stone section--tight" aria-labelledby="inc-title">
  <div class="wrap inc">
    <h2 id="inc-title">{ui.includes}</h2>
    <ul class="inc__list">
      {s.items.map((it) => <li><Icon name="check" size={22} /><span>{it[lang]}</span></li>)}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="rel-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div><h2 id="rel-title">{ui.related}</h2></div>
      <a class="more" href={href(V, lang, 'works')}>{ui.allWorks}<Icon name="arrow-right" size={18} /></a>
    </div>
    <div class="rel" data-reveal data-count={works.length}>
      {works.map((w) => <WorkCard work={w} lang={lang} />)}
    </div>
  </div>
</section>

<section class="section section--tight others-sec" aria-labelledby="others-title">
  <div class="wrap">
    <h2 id="others-title" class="others__h">{C.otherServices[lang]}</h2>
    <ul class="others">
      {others.map((o) => {
        const p = workById(SERVICE_PHOTO[o.id]).photos[0];
        return (
          <li>
            <a href={href(V, lang, 'services', o.slug[lang])}>
              <span class="ph others__ph"><Picture src={p.src} formats={['avif', 'webp']} widths={[160, 320]} sizes="80px" alt="" loading="lazy" decoding="async" /></span>
              <span class="others__t">{o.title[lang]}</span>
              <Icon name="arrow-right" size={18} />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<QuoteBand lang={lang} tipo={tipo} />

<style>
  .intro-cta { margin-top: var(--s4); }
  .lead-ph { aspect-ratio: 4 / 3; }
  .inc { display: grid; gap: var(--s3) var(--s8); }
  @media (min-width: 64rem) { .inc { grid-template-columns: 1fr 2fr; } }
  .inc h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .inc__list { list-style: none; display: grid; gap: 0 var(--s4); }
  @media (min-width: 40rem) { .inc__list { grid-template-columns: 1fr 1fr; } }
  .inc__list li { display: flex; gap: 0.75rem; align-items: flex-start; padding: 1rem 0; border-top: 1px solid var(--rule-strong); font-weight: 600; font-size: 1.0625rem; line-height: 1.4; }
  .inc__list :global(svg) { color: var(--blue); flex: none; }
  .rel { display: grid; gap: var(--s5) var(--s3); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .rel { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) {
    .rel { grid-template-columns: repeat(3, 1fr); gap: var(--s6) var(--s4); }
    .rel[data-count='1'], .rel[data-count='2'] { grid-template-columns: repeat(2, 1fr); }
    .rel[data-count='4'] { grid-template-columns: repeat(4, 1fr); }
    .rel[data-count='4'] :global(.wcard) { --ar: 4 / 5; }
  }
  .others-sec { padding-top: 0; }
  .others__h { font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: var(--s3); }
  .others { list-style: none; display: grid; gap: 0 var(--s4); border-top: 2px solid var(--ink); }
  @media (min-width: 48rem) { .others { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 80rem) { .others { grid-template-columns: repeat(3, 1fr); } }
  .others a {
    display: flex; align-items: center; gap: var(--s2); padding: 0.875rem 0; border-bottom: 1px solid var(--rule);
    color: var(--ink); text-decoration: none; font-weight: 650; line-height: 1.3;
  }
  .others__ph { flex: none; width: 4.5rem; height: 3.5rem; border-radius: 10px; }
  .others__ph :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .others__t { flex: 1; }
  .others a :global(svg) { color: var(--blue); flex: none; transition: transform 240ms var(--ease-out); }
  .others a:hover :global(svg) { transform: translateX(4px); }
  .others a:hover .others__t { text-decoration: underline; text-underline-offset: 0.2em; }
</style>

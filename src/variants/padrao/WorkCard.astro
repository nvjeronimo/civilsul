---
import { Picture } from 'astro:assets';
import { href, type Lang } from '../../lib/site';
import { KINDS, type Work } from '../../content/works';
import { V } from './copy';

interface Props {
  work: Work;
  lang: Lang;
  sizes?: string;
  level?: 'h2' | 'h3';
  class?: string;
  vt?: boolean; // nome de View Transition (filtro de obras)
  eager?: boolean;
  photo?: number;
  cell?: string; // estilo extra (posição na grelha)
}
const { work, lang, sizes = '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw', level = 'h3', class: cls, vt = false, eager = false, photo: pi = 0, cell = '' } = Astro.props;
const H = level;
const kind = KINDS.find((k) => k.id === work.kind)!.label[lang];
const extra = work.place ?? work.client;
const photo = work.photos[pi] ?? work.photos[0];
const style = [vt ? `view-transition-name: w-${work.id}` : '', cell].filter(Boolean).join('; ') || undefined;
---
<article class:list={['wcard', cls]} data-kind={work.kind} style={style}>
  <a class="wcard__link" href={href(V, lang, 'works', work.slug[lang])}>
    <div class="ph wcard__ph">
      <Picture src={photo.src} formats={['avif', 'webp']} widths={[480, 720, 960, 1280]} sizes={sizes} alt={photo.alt[lang]} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="wcard__text">
      <H class="wcard__title">{work.title[lang]}</H>
      <p class="wcard__meta">{kind}{extra && <><span aria-hidden="true"> · </span>{extra}</>}</p>
    </div>
  </a>
</article>

<style>
  .wcard { display: flex; flex-direction: column; min-width: 0; }
  .wcard__link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .wcard__ph { flex: none; aspect-ratio: var(--ar, 4 / 3); }
  .wcard__ph :global(img) { transition: transform 900ms var(--ease-out); }
  .wcard__link:hover .wcard__ph :global(img) { transform: scale(1.035); }
  .wcard__text { padding-top: 1rem; }
  .wcard__title { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.012em; line-height: 1.3; }
  .wcard__link:hover .wcard__title { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 0.2em; }
  .wcard__meta { margin-top: 0.25rem; color: var(--ink-3); font-size: var(--fs-small); font-weight: 500; }
  .wcard__link:focus-visible { outline-offset: 6px; border-radius: var(--radius); }
</style>

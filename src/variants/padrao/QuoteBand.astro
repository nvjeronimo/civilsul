---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { UI, SITE, CALL_NOTE, href, tel, whatsapp, type Lang } from '../../lib/site';
import { INVITE } from '../../content/company';
import { workById } from '../../content/works';
import { C, V } from './copy';

interface Props { lang: Lang; title?: string; text?: string; tipo?: string; photo?: string | null }
const { lang, title = C.bandTitle[lang], text = INVITE[lang], tipo, photo = 'arranjos-exteriores-terraco' } = Astro.props;
const ui = UI[lang];
const w = photo ? workById(photo) : null;
const quoteHref = href(V, lang, 'quote') + (tipo ? `?tipo=${tipo}` : '');
---
<section class="band section" aria-labelledby="band-title">
  <div class="wrap">
    <div class:list={['band__panel', { 'band__panel--text': !w }]} data-reveal>
      <div class="band__text">
        <div class="band__a">
          <h2 id="band-title">{title}</h2>
          <p class="band__lead">{text}</p>
        </div>
        <div class="band__b">
        <div class="btn-row">
          <a class="btn btn--primary" href={quoteHref}>{ui.nav.quote}<Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--ghost-light" href={whatsapp(lang)} target="_blank" rel="noopener"><Icon name="chat" size={20} />{C.whatsappCta[lang]}</a>
        </div>
        <div class="band__direct">
          <p class="band__or">{C.bandOr[lang]}</p>
          <ul>
            <li>
              <a href={tel(SITE.mobile.tel)}><Icon name="phone" size={18} /><span class="tel">{SITE.mobile.display}</span></a>
              <span class="band__note">{CALL_NOTE.mobile[lang]}</span>
            </li>
            <li>
              <a href={tel(SITE.landlines[0].tel)}><Icon name="phone" size={18} /><span class="tel">{SITE.landlines[0].display}</span></a>
              <span class="band__note">{CALL_NOTE.landline[lang]}</span>
            </li>
            <li>
              <a href={`mailto:${SITE.email}`}><Icon name="mail" size={18} /><span>{SITE.email}</span></a>
            </li>
          </ul>
        </div>
        </div>
      </div>
      {w && (
        <div class="band__ph">
          <Picture src={w.photos[0].src} formats={['avif', 'webp']} widths={[480, 800, 1100]} sizes="(min-width: 64rem) 40vw, 100vw" alt={w.photos[0].alt[lang]} loading="lazy" decoding="async" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .band { padding-block: clamp(3rem, 2rem + 4vw, 6rem) var(--section); }
  .band__panel {
    display: grid; grid-template-columns: 1fr; overflow: hidden;
    background: var(--ink); color: var(--on-ink-2); border-radius: var(--radius);
  }
  @media (min-width: 64rem) {
    .band__panel { grid-template-columns: 1.15fr 1fr; }
    .band__panel--text { grid-template-columns: 1fr; }
    .band__panel--text .band__text { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--s12); align-items: end; }
    .band__panel--text .band__b > .btn-row { margin-top: 0; }
  }
  .band__text { padding: clamp(2rem, 1rem + 4vw, 4.5rem); }
  .band h2 { color: #fff; max-width: 16ch; }
  .band__lead { margin-top: var(--s3); font-size: var(--fs-lead); line-height: 1.55; max-width: 36rem; }
  .band .btn-row { margin-top: var(--s5); }
  .band__direct { margin-top: var(--s5); padding-top: var(--s4); border-top: 1px solid rgba(255, 255, 255, 0.16); }
  .band__or { font-size: var(--fs-small); color: var(--on-ink-2); margin-bottom: var(--s1); }
  .band__direct ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); }
  .band__direct li { display: grid; }
  .band__direct a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; color: #fff; font-weight: 650; text-decoration: none; }
  .band__direct a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .band__direct a :global(svg) { color: #6cc0f2; }
  .band__note { margin-top: -0.375rem; font-size: var(--fs-note); padding-left: calc(18px + 0.5rem); }
  .band__ph { position: relative; min-height: 18rem; }
  .band__ph :global(picture), .band__ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .band :focus-visible { outline-color: #6cc0f2; }
</style>
